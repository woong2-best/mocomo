{
  "expo": {
    "name": "MoCoMo",
    "slug": "mocomo",
    "version": "1.0.94",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "mocomo",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "plugins": [
      "expo-secure-store",
      "expo-image",
      "expo-video",
      "expo-dev-client",
      "@livekit/react-native-expo-plugin",
      [
        "expo-image-picker",
        {
          "photosPermission": "???? ???????????????? ?????????????",
          "cameraPermission": "???? ?????????? ?????????????????"
        }
      ],
      "expo-web-browser",
      "expo-audio",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#2E4A8E",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "???????????????????? ???? ????????"
        }
      ],
      "@maplibre/maplibre-react-native",
      "./plugins/with-kakao-maps"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "net.mocomo.app",
      "buildNumber": "98",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification",
          "audio"
        ],
        "NSPhotoLibraryUsageDescription": "???? ???????????????? ?????????????",
        "NSCameraUsageDescription": "???? ?????????? ?????????????????",
        "NSMicrophoneUsageDescription": "??? ??? ???????????????????????????????",
        "NSLocationWhenInUseUsageDescription": "???????????????????? ???? ????????",
        "KAKAO_APP_KEY": "b52b08185d2635a1cbeefd2d7236919d"
      }
    },
    "android": {
      "package": "net.mocomo.app",
      "googleServicesFile": "./google-services.json",
      "versionCode": 99,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#F5F0E8",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "permissions": [
        "INTERNET",
        "POST_NOTIFICATIONS",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "CAMERA",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "ACCESS_NETWORK_STATE",
        "BLUETOOTH",
        "BLUETOOTH_CONNECT",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "replace-with-eas-project-id"
      },
      "apiBaseUrl": "https://mocomo.net",
      "socketUrl": "https://mocomo.net",
      "kakaoNativeAppKey": "b52b08185d2635a1cbeefd2d7236919d",
      "googleWebClientId": "382483122683-0bqhh4dl4r8k7ogcu6802j4sg2ckeait.apps.googleusercontent.com"
    },
    "owner": "replace-with-expo-username"
