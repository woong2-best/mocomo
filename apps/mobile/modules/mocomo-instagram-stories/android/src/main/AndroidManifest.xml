<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <queries>
    <package android:name="com.instagram.android" />
    <intent>
      <action android:name="com.instagram.share.ADD_TO_STORY" />
    </intent>
  </queries>

  <application>
    <provider
      android:name="net.mocomo.instagramstories.InstagramStoriesFileProvider"
      android:authorities="${applicationId}.instagramstories.provider"
      android:exported="false"
      android:grantUriPermissions="true">
      <meta-data
        android:name="android.support.FILE_PROVIDER_PATHS"
        android:resource="@xml/instagram_stories_file_paths" />
    </provider>
  </application>
</manifest>
