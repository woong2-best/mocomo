{
  "name": "mocomo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:web\" \"npm run dev:socket\"",
    "dev:web": "next dev",
    "dev:socket": "tsx watch server/socket.ts",
    "start:socket": "npx tsx server/socket.ts",
    "build": "prisma generate && next build",
    "vercel-build": "prisma generate && node scripts/copy-mediapipe-assets.cjs && node scripts/copy-avatar-assets.cjs && (prisma db push --accept-data-loss && tsx prisma/seed.ts || echo DB sync skipped) && next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:find-pooler": "tsx scripts/find-supabase-pooler.ts",
    "db:recalc-tiers": "tsx scripts/recalc-support-tiers.ts",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "operator:assign": "tsx scripts/set-operator.ts",
    "operator:revoke": "tsx scripts/revoke-unauthorized-admins.ts",
    "oauth:discord": "tsx scripts/discord-oauth-setup.ts",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate && node scripts/copy-mediapipe-assets.cjs && node scripts/copy-avatar-assets.cjs",
    "mediapipe:assets": "node scripts/copy-mediapipe-assets.cjs",
    "avatar:assets": "node scripts/copy-avatar-assets.cjs",
    "avatar:parts": "npx tsx scripts/generate-avatar-parts.ts",
    "word-chain:build": "tsx scripts/build-word-chain-dictionary.ts",
    "word-chain:import-opendict": "tsx scripts/import-opendict-xml.ts",
    "cap:sync": "npx cap sync android",
    "cap:open": "npx cap open android",
    "android:build": "cd android && gradlew.bat assembleRelease",
    "android:debug": "npx cap sync android && cd android && gradlew.bat assembleDebug",
    "android:bundle": "npx cap sync android && cd android && gradlew.bat bundleRelease"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.7.4",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@capacitor/android": "^8.4.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.4.0",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@dnd-kit/core": "^6.3.1",
    "@hookform/resolvers": "^3.9.1",
    "@livekit/components-react": "^2.8.1",
    "@livekit/components-styles": "^1.1.4",
    "@mediapipe/tasks-vision": "^0.10.35",
    "@pixiv/three-vrm": "^3.5.3",
    "@prisma/client": "^6.1.0",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-scroll-area": "^1.2.2",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-switch": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-toast": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.1",
    "@tosspayments/tosspayments-sdk": "^2.7.0",
    "@upstash/ratelimit": "^2.0.5",
    "@upstash/redis": "^1.34.3",
    "@vercel/speed-insights": "^2.0.0",
    "bcryptjs": "^2.4.3",
    "chess.js": "^1.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "flv.js": "^1.6.2",
    "framer-motion": "^11.15.0",
    "hls.js": "^1.6.16",
    "leaflet": "^1.9.4",
    "livekit-server-sdk": "^2.9.1",
    "lucide-react": "^0.468.0",
    "next": "^15.1.0",
    "next-auth": "^5.0.0-beta.25",
    "next-themes": "^0.4.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-easy-crop": "^5.5.7",
    "react-hook-form": "^7.54.2",
    "resend": "^4.0.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "stripe": "^22.1.1",
    "tailwind-merge": "^2.6.0",
    "three": "^0.184.0",
    "tsx": "^4.19.2",
    "web-push": "^3.6.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/three": "^0.184.1",
    "@types/web-push": "^3.6.4",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "playwright": "^1.61.0",
    "postcss": "^8.4.49",
    "prisma": "^6.1.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
}
