{
  "name": "mocomo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:web\" \"npm run dev:socket\"",
    "dev:web": "next dev",
    "dev:socket": "tsx watch server/socket.ts",
    "start:socket": "npx tsx server/socket.ts",
    "build": "prisma generate && next build",
    "vercel-build": "prisma generate && node scripts/copy-mediapipe-assets.cjs && node scripts/copy-avatar-assets.cjs && (prisma db push --accept-data-loss && tsx prisma/seed.ts || echo DB sync skipped) && next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:find-pooler": "tsx scripts/find-supabase-pooler.ts",
    "db:recalc-tiers": "tsx scripts/recalc-support-tiers.ts",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "operator:assign": "tsx scripts/set-operator.ts",
    "operator:revoke": "tsx scripts/revoke-unauthorized-admins.ts",
    "oauth:discord": "tsx scripts/discord-oauth-setup.ts",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate && node scripts/copy-mediapipe-assets.cjs && node scripts/copy-avatar-assets.cjs",
    "mediapipe:assets": "node scripts/copy-mediapipe-assets.cjs",
    "avatar:assets": "node scripts/copy-avatar-assets.cjs",
    "avatar:parts": "npx tsx scripts/generate-avatar-parts.ts",
    "word-chain:build": "tsx scripts/build-word-chain-dictionary.ts",
    "word-chain:import-opendict": "tsx scripts/import-opendict-xml.ts",
    "economy:qa": "tsx scripts/economy-qa.ts",
    "economy:stress": "tsx scripts/economy-stress.ts",
    "economy:stress:quick": "tsx scripts/economy-stress.ts --quick",
    "economy:stress:500": "tsx scripts/economy-stress.ts --users=500",
    "economy:stress:1000": "tsx scripts/economy-stress.ts --users=1000",
    "economy:stress:5000": "tsx scripts/economy-stress.ts --users=5000",
    "economy:fraud-scan": "tsx scripts/economy-fraud-scan.ts",
    "persona:smoke": "node scripts/persona1-smoke.mjs",
    "persona:record": "node scripts/persona-record.mjs",
    "persona:auth-smoke": "node scripts/persona-auth-smoke.mjs",
    "health:prod": "node scripts/prod-health-check.mjs",
    "smoke:api": "node scripts/smoke-api.mjs",
    "economy:backup": "tsx scripts/economy-backup-daily.ts",
    "economy:health": "tsx scripts/economy-health-scan.ts",
    "diorama:export-living": "tsx scripts/export-living-preset.ts",
    "diorama:art-pass": "node scripts/living-room-art-pass.mjs",
    "diorama:capture-rc1": "node scripts/capture-rc1-living.mjs",
    "iap:retry": "tsx scripts/iap-retry.ts",
    "cap:sync": "npx cap sync android",
    "cap:sync:ios": "npx cap sync ios",
    "cap:open": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "android:build": "cd android && gradlew.bat assembleRelease",
    "android:debug": "npx cap sync android && cd android && gradlew.bat assembleDebug",
    "android:bundle": "npx cap sync android && cd android && gradlew.bat bundleRelease"
  },
