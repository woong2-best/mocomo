  @@index([targetUserId, createdAt])
  @@index([action, createdAt])
}

/** 관리자·운영자 민감 접근 감사 (개인정보 조회·보내기 등) */
model SiteAdminAuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  targetType String?
  targetId   String?
  ip         String?
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User @relation("SiteAdminAuditActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([targetId])
