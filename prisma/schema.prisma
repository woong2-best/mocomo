  liveSupportMissions LiveSupportMission[]
  liveSupportPolls    LiveSupportPoll[]
  liveVideoDonations  LiveVideoDonation[]

  @@index([isLive, liveStatus, createdAt(sort: Desc)])
  @@index([isLive, liveStatus, category, createdAt(sort: Desc)])
  @@index([liveStatus, scheduledAt])
  @@index([createdBy, isLive, liveStatus])
}

