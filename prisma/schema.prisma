// ============ 크리에이터 작품 (웹툰·사진·영상 판매) ============

enum CreatorWorkKind {
  WEBTOON
  PHOTO
  VIDEO
}

enum WebtoonPublishDay {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

enum WebtoonGenre {
  SCHOOL
  ACTION
  SF
  STORY
  FANTASY
  BL_GL
  COMEDY
  PURE_LOVE
  DRAMA
  ROMANCE
  HISTORICAL
  SPORTS
  SLICE_OF_LIFE
  MYSTERY
  HORROR
  ADULT
  OMNIBUS
  EPISODE
  MARTIAL_ARTS
  SHONEN
  OTHER
}

model CreatorSeries {
  id          String             @id @default(cuid())
  authorId    String
  title       String
  description String?            @db.Text
  coverUrl    String
  kind        CreatorWorkKind
  publishDay  WebtoonPublishDay?
  genre       WebtoonGenre?
  status      String             @default("ONGOING")
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  author   User             @relation("CreatorSeriesAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  episodes CreatorEpisode[]

  @@index([authorId, createdAt(sort: Desc)])
  @@index([kind, createdAt(sort: Desc)])
  @@index([kind, publishDay])
  @@index([kind, genre])
}

model CreatorEpisode {
  id               String          @id @default(cuid())
  seriesId         String
  authorId         String
  title            String
  episodeNo        Int
  price            Int             @default(0)
  previewUrls      Json            @default("[]")
  contentUrls      Json            @default("[]")
  videoUrl         String?
  freePreviewCount Int             @default(1)
  salesCount       Int             @default(0)
  viewCount        Int             @default(0)
  published        Boolean         @default(true)
  scheduledAt      DateTime?
  publishedAt      DateTime?
  createdAt        DateTime        @default(now())

  series    CreatorSeries            @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  author    User                     @relation("CreatorEpisodeAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  purchases CreatorEpisodePurchase[]

  @@unique([seriesId, episodeNo])
  @@index([seriesId, episodeNo])
}

model CreatorEpisodePurchase {
  id        String   @id @default(cuid())
  buyerId   String
  episodeId String
  price     Int
  createdAt DateTime @default(now())

  buyer   User           @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  episode CreatorEpisode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([buyerId, episodeId])
  @@index([buyerId, createdAt(sort: Desc)])
}

// ============ 웹툰 드로잉 스튜디오 (클라우드) ============

model WebtoonStudioProject {
  id        String   @id @default(cuid())
  userId    String
  name      String
  data      Json
  favorite  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt(sort: Desc)])
  @@index([userId, favorite])
}

model WebtoonStudioSettings {
  userId    String   @id
  brushes   Json     @default("[]")
  palette   Json     @default("[]")
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============ VIRTUAL AVATAR STUDIO ============

model AvatarPreset {
  id        String   @id @default(cuid())
  userId    String   @unique
  name      String   @default("기본")
  config    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============ APT (아파트 생활 시뮬레이션) ============

model AptProfile {
  id                String    @id @default(cuid())
  userId            String    @unique
  moveInCompletedAt DateTime?
  housingType       String    @default("apartment")
  countryCode       String    @default("KR")
  latitude          Float?
  longitude         Float?
  regionLabel       String?
  homeFloor         Int       @default(50)
  floorPlans        Json      @default("{}")
  furniture         Json      @default("[]")
  residents         Json      @default("[]")
  simulationState   Json      @default("{}")
  houseBuild        Json      @default("{}")
  homePublic        Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/** 스티커 다이오라마 방별 배치 — 기기 간 동기화 */
model AptDioramaLayout {
  id        String   @id @default(cuid())
  userId    String
  roomId    String
  instances Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roomId])
  @@index([userId])
}

/** APT 집 방문 기록 — 방명록·랭킹·커뮤니티 통계 */
model AptHomeVisit {
  id        String   @id @default(cuid())
  hostId    String
  visitorId String
  createdAt DateTime @default(now())

  host    User @relation("AptVisitHost", fields: [hostId], references: [id], onDelete: Cascade)
  visitor User @relation("AptVisitVisitor", fields: [visitorId], references: [id], onDelete: Cascade)

  @@index([hostId, createdAt(sort: Desc)])
  @@index([visitorId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}

/** APT 실시간 접속 — 로비·광장·복도 아바타 표시 */
model AptPresence {
  userId         String   @id
  countryCode    String   @default("KR")
  mode           String   @default("district")
  homeFloor      Int      @default(50)
  visitingUserId String?
  lastSeenAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([countryCode, lastSeenAt(sort: Desc)])
  @@index([mode, countryCode, lastSeenAt(sort: Desc)])
  @@index([visitingUserId, lastSeenAt(sort: Desc)])
}

/** APT 집 좋아요 — 오늘의 집·주간 베스트 룸 집계 */
model AptHomeLike {
  id        String   @id @default(cuid())
  hostId    String
  likerId   String
  createdAt DateTime @default(now())

  host  User @relation("AptHomeLikeHost", fields: [hostId], references: [id], onDelete: Cascade)
  liker User @relation("AptHomeLiker", fields: [likerId], references: [id], onDelete: Cascade)

  @@unique([hostId, likerId])
  @@index([hostId, createdAt(sort: Desc)])
  @@index([likerId, createdAt(sort: Desc)])
}

/** APT 즐겨찾는 집 / 이웃 */
model AptFavoriteHome {
  id        String   @id @default(cuid())
  userId    String
  hostId    String
  createdAt DateTime @default(now())

  user User @relation("AptFavoriteOwner", fields: [userId], references: [id], onDelete: Cascade)
  host User @relation("AptFavoriteHost", fields: [hostId], references: [id], onDelete: Cascade)

  @@unique([userId, hostId])
  @@index([userId, createdAt(sort: Desc)])
}

/** APT 동거 신청 — 집주인 알림창에서 수락/거절 */
model AptCohabitationRequest {
  id          String    @id @default(cuid())
  requesterId String
  hostId      String
  roomId      String?
  status      String    @default("PENDING")
  message     String?   @db.Text
  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  requester User @relation("AptCohabRequestRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  host      User @relation("AptCohabRequestHost", fields: [hostId], references: [id], onDelete: Cascade)

  @@index([hostId, status, createdAt(sort: Desc)])
  @@index([requesterId, status, createdAt(sort: Desc)])
}

/** APT 동거자 — 기본 최대 2명 거주, 동거자는 집주인 빈 방에 연결 */
model AptCohabitant {
  id              String    @id @default(cuid())
  hostId          String
  residentId      String
  roomId          String
  status          String    @default("ACTIVE")
  movedInAt       DateTime  @default(now())
  moveOutRequestedById String?
  moveOutRequestedAt DateTime?
  endedAt         DateTime?

  host     User @relation("AptCohabHost", fields: [hostId], references: [id], onDelete: Cascade)
  resident User @relation("AptCohabResident", fields: [residentId], references: [id], onDelete: Cascade)

  @@unique([residentId])
  @@index([hostId, status])
  @@index([residentId, status])
}

/** APT 게임 경제 — 골드·젬 (크리에이터 Wallet과 분리) */
model AptWallet {
  userId        String   @id
  gold          Int      @default(0)
  gems          Int      @default(0)
  legacyMigrated Boolean @default(false)
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/** APT 인벤토리 — 보유 아이템 (가구·벽지·장식 등 공통) */
model AptInventoryItem {
  id         String   @id @default(cuid())
  userId     String
  itemId     String
  quantity   Int      @default(1)
  acquiredAt DateTime @default(now())
  /** shop | market | flea | gift | event | starter */
  source     String   @default("shop")
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
  @@index([userId])
}

/** APT 창고 — 배치 가능 수량 (Inventory − 집 배치) */
model AptStorageItem {
  userId    String
  itemId    String
  quantity  Int      @default(0)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, itemId])
  @@index([userId])
}

/** IAP·젬 상점 상품 — Google Play productId 1:1 */
model AptShopProduct {
  id          String   @id @default(cuid())
  slug        String   @unique
  productId   String   @unique
  type        String
  amount      Int
  bonusAmount Int      @default(0)
  priceTier   Int      @default(1)
  title       String
  description String?
  enabled     Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/** 공식 골드 상점 — 추천·한정·할인 */
model AptGoldShopOffer {
  id                String    @id @default(cuid())
  itemId            String    @unique
  goldPrice         Int
  originalGoldPrice Int?
  featured          Boolean   @default(false)
  isNew             Boolean   @default(false)
  limitedStock      Int?
  soldCount         Int       @default(0)
  startsAt          DateTime?
  endsAt            DateTime?
  enabled           Boolean   @default(true)
  sortOrder         Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([enabled, featured, sortOrder])
  changeLogs AptGoldShopOfferChangeLog[]
}

/** Gold Shop 상품 변경 이력 */
model AptGoldShopOfferChangeLog {
  id        String   @id @default(cuid())
  offerId   String
  itemId    String
  adminId   String
  field     String
  before    String
  after     String
  createdAt DateTime @default(now())
  offer     AptGoldShopOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  admin     User     @relation("AptGoldShopOfferChanges", fields: [adminId], references: [id], onDelete: Cascade)

  @@index([offerId, createdAt(sort: Desc)])
  @@index([itemId, createdAt(sort: Desc)])
}

/** 벼룩시장 이벤트 — 일반 장터 위 레이어 */
model AptFleaEvent {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String?
  notice      String?
  bannerUrl   String?
  startsAt    DateTime
  endsAt      DateTime
  feeRate     Float    @default(0.05)
  active      Boolean  @default(true)
  published   Boolean  @default(false)
  visitCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  listings   AptMarketListing[]
  npcOffers  AptFleaNpcOffer[]
  changeLogs AptFleaEventChangeLog[]

  @@index([active, published, startsAt, endsAt])
}

/** 벼룩시장 NPC 상품 — 운영자가 이벤트마다 판매/매입 설정 */
model AptFleaNpcOffer {
  id              String   @id @default(cuid())
  eventId         String
  kind            String
  stickerTypeId   String
  goldPrice       Int
  discountPercent Int?
  stock           Int?
  soldCount       Int      @default(0)
  boughtCount     Int      @default(0)
  enabled         Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  event AptFleaEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, enabled, sortOrder])
}

/** 벼룩시장 이벤트 변경 이력 */
model AptFleaEventChangeLog {
  id        String   @id @default(cuid())
  eventId   String
  adminId   String
  field     String
  before    String
  after     String
  createdAt DateTime @default(now())
  event     AptFleaEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  admin     User     @relation("AptFleaEventChanges", fields: [adminId], references: [id], onDelete: Cascade)

  @@index([eventId, createdAt(sort: Desc)])
}

/** APT 경제 설정 — 버전·긴급 모드 포함 */
model AptEconomyConfig {
  id                    String    @id @default("default")
  version               Int       @default(1)
  publishedAt           DateTime?
  publishedById         String?

  goldPerGem            Int       @default(100)
  bonusRate             Float     @default(0)
  dailyGemExchangeLimit Int       @default(10000)
  dailyGoldLimit        Int       @default(50000)
  marketFee             Float     @default(0.05)
  npcBuyRate            Float     @default(0.65)
  npcSellRate           Float     @default(0.70)
  starterGold           Int       @default(500)

  liveGoldPerCheer      Int       @default(2)
  dailyLiveGoldLimit    Int       @default(5000)
  liveWatchGoldPerMin   Int       @default(15)
  dailyWatchGoldLimit   Int       @default(3000)

  dailyMissionReward    Int       @default(80)
  weeklyMissionReward   Int       @default(400)

  featuredRefreshHour   Int       @default(0)
  newItemDays           Int       @default(7)
  discountDefaultRate   Float     @default(0.20)

  recommendPriceWindow  Int       @default(20)
  maxListingDays        Int       @default(30)
  priceHistoryDays      Int       @default(90)

  defaultFleaFee        Float     @default(0.05)
  defaultFleaDiscount   Float     @default(0.30)
  fleaEventCooldownHrs  Int       @default(168)

  pendingExpireDays     Int       @default(30)
  maxOfflineOps         Int       @default(100)

  emergencyMode         Boolean   @default(false)

  fraudRestrictScore    Int       @default(70)
  fraudMarketBlockScore Int       @default(90)
  fraudLiveBlockScore   Int       @default(95)

  updatedAt             DateTime  @updatedAt
  publishedBy           User?     @relation("AptEconomyConfigPublisher", fields: [publishedById], references: [id], onDelete: SetNull)
}

/** Economy Config 변경 감사 */
model AptEconomyConfigChangeLog {
  id         String   @id @default(cuid())
  adminId    String
  field      String
  before     String
  after      String
  reason     String?
  ip         String?
  version    Int?
  createdAt  DateTime @default(now())
  admin      User     @relation("AptEconomyConfigChanges", fields: [adminId], references: [id], onDelete: Cascade)

  @@index([createdAt(sort: Desc)])
  @@index([field, createdAt(sort: Desc)])
  @@index([version, createdAt(sort: Desc)])
}

/** 경제 기능 Kill Switch — 기능별 ON/OFF (Emergency보다 세분화) */
model AptEconomyFeatureFlag {
  id                  String   @id @default("default")
  shopEnabled         Boolean  @default(true)
  marketEnabled       Boolean  @default(true)
  liveEnabled         Boolean  @default(true)
  missionEnabled      Boolean  @default(true)
  notificationEnabled Boolean  @default(true)
  fleaEnabled         Boolean  @default(true)
  iapEnabled          Boolean  @default(true)
  updatedAt           DateTime @updatedAt
  updatedById         String?
  updatedBy           User?    @relation("AptEconomyFeatureFlagUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
}

/** Feature Flag 변경 감사 */
model AptEconomyFeatureFlagLog {
  id        String   @id @default(cuid())
  adminId   String
  feature   String
  before    String
  after     String
  reason    String?
  ip        String?
  createdAt DateTime @default(now())
  admin     User     @relation("AptEconomyFeatureFlagLogs", fields: [adminId], references: [id], onDelete: Cascade)

  @@index([createdAt(sort: Desc)])
  @@index([feature, createdAt(sort: Desc)])
}

/** 경제 전체 스냅샷 — 운영 복구용 */
model AptEconomySnapshot {
  id          String   @id @default(cuid())
  label       String
  type        String
  stats       Json
  payload     Json
  checksum    String
  createdAt   DateTime @default(now())
  createdById String?
  createdBy   User?    @relation("AptEconomySnapshotCreator", fields: [createdById], references: [id], onDelete: SetNull)
  restores    AptEconomyRestoreLog[]

  @@index([type, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}

/** Canary 점진 배포 — 경제 변경 실험 */
model AptEconomyCanary {
  id                 String    @id @default(cuid())
  targetType         String
  targetId           String    @default("default")
  stage              String    @default("DRAFT")
  percent            Int       @default(0)
  operatorUserIds    Json      @default("[]")
  testerUserIds      Json      @default("[]")
  draftPayload       Json
  reason             String?
  publishedVersion   Int?
  rollbackSnapshotId String?
  correlationId      String?
  autoRollback       Boolean   @default(true)
  createdById        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  startedAt          DateTime?
  completedAt        DateTime?

  createdBy     User?                        @relation("AptEconomyCanaryCreator", fields: [createdById], references: [id], onDelete: SetNull)
  logs          AptEconomyCanaryLog[]
  healthMetrics AptEconomyCanaryHealthMetric[]

  @@index([targetType, targetId, completedAt])
  @@index([stage, updatedAt(sort: Desc)])
}

/** Canary 단계 변경 감사 */
model AptEconomyCanaryLog {
  id            String   @id @default(cuid())
  canaryId      String
  adminId       String?
  action        String
  fromStage     String?
  toStage       String?
  fromPercent   Int?
  toPercent     Int?
  correlationId String
  reason        String?
  metadata      Json?
  createdAt     DateTime @default(now())

  canary AptEconomyCanary @relation(fields: [canaryId], references: [id], onDelete: Cascade)
  admin  User?            @relation("AptEconomyCanaryAdmin", fields: [adminId], references: [id], onDelete: SetNull)

  @@index([canaryId, createdAt(sort: Desc)])
  @@index([correlationId])
  @@index([createdAt(sort: Desc)])
}

/** Canary Health Monitor 연계 메트릭 */
model AptEconomyCanaryHealthMetric {
  id                 String   @id @default(cuid())
