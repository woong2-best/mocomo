// ============ MODERATION ============

enum ReportTargetType {
  USER
  POST
  COMMENT
  MESSAGE
  USED_LISTING
  LIVE_CHANNEL
  LIVE_CHAT
  STREAM_CLIP
  MARKETPLACE_LISTING
  MARKETPLACE_SELLER
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}

model Report {
  id         String   @id @default(cuid())
  reporterId String
  targetType ReportTargetType
  targetId   String
  reason     String
  details    String?  @db.Text
  status     ReportStatus @default(PENDING)
  moderationCaseId String?
  createdAt  DateTime @default(now())
  reporter   User @relation("Reporter", fields: [reporterId], references: [id])
  reportedUserId String?
  reportedUser User? @relation("ReportedUser", fields: [reportedUserId], references: [id])
  moderationCase ModerationCase? @relation(fields: [moderationCaseId], references: [id], onDelete: SetNull)
  postId     String?
  post       Post? @relation(fields: [postId], references: [id])
  commentId  String?
  comment    Comment? @relation(fields: [commentId], references: [id])
}

model ModLog {
  id        String   @id @default(cuid())
  actorId   String
  targetId  String
  action    String
  reason    String?
  metadata  Json?
  createdAt DateTime @default(now())
  actor  User @relation("ModActor", fields: [actorId], references: [id])
  target User @relation("ModTarget", fields: [targetId], references: [id])
}

model AccountSuspensionLog {
  id              String        @id @default(cuid())
  userId          String
  actorId         String?
  previousStatus  AccountStatus
  newStatus       AccountStatus
  reason          String?       @db.Text
  isPermanent     Boolean       @default(false)
  metadata        Json?
  createdAt       DateTime      @default(now())

  user  User  @relation("SuspensionTarget", fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("SuspensionActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model AccountAppeal {
  id                       String        @id @default(cuid())
  userId                   String
  accountStatusAtSubmit    AccountStatus
  suspensionReasonSnapshot String?       @db.Text
  title                    String
  content                  String        @db.Text
  contactEmail             String
  allowFollowUpEmail       Boolean       @default(true)
  status                   AppealStatus  @default(RECEIVED)
  adminNotes               String?       @db.Text
  adminId                  String?
  decisionNote             String?       @db.Text
  decidedAt                DateTime?
  infoRequestedAt          DateTime?
  infoDueAt                DateTime?
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  user        User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  admin       User?                     @relation("AppealAdmin", fields: [adminId], references: [id], onDelete: SetNull)
  attachments AccountAppealAttachment[]
  responses   AccountAppealResponse[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model AccountAppealAttachment {
  id        String   @id @default(cuid())
  appealId  String
  url       String
  filename  String
  mimeType  String
  sizeBytes Int
  createdAt DateTime @default(now())

  appeal AccountAppeal @relation(fields: [appealId], references: [id], onDelete: Cascade)

  @@index([appealId])
}

model AccountAppealResponse {
  id        String   @id @default(cuid())
  appealId  String
  authorId  String?
  content   String   @db.Text
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())

  appeal AccountAppeal @relation(fields: [appealId], references: [id], onDelete: Cascade)

  @@index([appealId, createdAt])
}

model BanEvasionSuspect {
  id           String   @id @default(cuid())
  userId       String
  linkedUserId String
  matchType    String
  metadata     Json?
  reviewed     Boolean  @default(false)
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime @default(now())

  user       User @relation("BanEvasionNew", fields: [userId], references: [id], onDelete: Cascade)
  linkedUser User @relation("BanEvasionLinked", fields: [linkedUserId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([linkedUserId])
  @@index([reviewed, createdAt])
}

model RiskScoreEvent {
  id         String          @id @default(cuid())
  userId     String
  delta      Int
  reason     String
  source     RiskScoreSource @default(SYSTEM)
  scoreAfter Int
  metadata   Json?
  createdAt  DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model ModerationCase {
  id                  String               @id @default(cuid())
  reportedUserId      String
  status              ModerationCaseStatus @default(OPEN)
  reportCount         Int                  @default(1)
  riskScoreSnapshot   Int                  @default(0)
  aiConfidence        Float?
  recommendedAction   String?
  recommendedReason   String?              @db.Text
  assignedAdminId     String?
  resolvedAt          DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  reportedUser User     @relation("ModerationCaseSubject", fields: [reportedUserId], references: [id], onDelete: Cascade)
  reports      Report[]

  @@index([reportedUserId, status])
  @@index([status, riskScoreSnapshot])
}

model ModerationAiAnalysis {
  id                String   @id @default(cuid())
  userId            String
  contentType       String
  contentId         String?
  riskDelta         Int      @default(0)
  confidence        Float?
  recommendedAction String?
  recommendedReason String?  @db.Text
  rawResult         Json?
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([contentType, contentId])
}

model StaffCreationLog {
  id            String   @id @default(cuid())
  createdUserId String
  creatorId     String
  role          UserRole
  displayName   String?
  email         String?
  reason        String   @db.Text
  creatorIp     String?
  createdAt     DateTime @default(now())

  createdUser User @relation("StaffCreated", fields: [createdUserId], references: [id], onDelete: Cascade)
  creator     User @relation("StaffCreator", fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([createdUserId])
  @@index([creatorId, createdAt])
}

model ModerationAuditLog {
