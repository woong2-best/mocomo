}

model AdSlot {
  id           String   @id @default(cuid())
  position     String
  title        String
  imageUrl     String
  linkUrl      String
  sponsorName  String?
  ctaLabel     String?
  adCategory   String?
  isFeedAd     Boolean  @default(false)
  active       Boolean  @default(true)
