  key       String   @unique
  value     Json
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([updatedAt])
}

/** 회원에 대한 관리자 내부 메모 */
model AdminUserMemo {
  id        String   @id @default(cuid())
  userId    String
  authorId  String
  body      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User @relation("AdminMemoSubject", fields: [userId], references: [id], onDelete: Cascade)
  author User @relation("AdminMemoAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([authorId])
}

// ============ COUPON / PROMOTION ============

enum CouponBenefitType {
  FEE_WAIVER
  FEE_PERCENT_OFF
  FIXED_AMOUNT
}

enum CouponAudience {
  ALL_USERS
  SPECIFIC_USERS
  SPECIFIC_CREATORS
  SPECIFIC_TIER
}

enum CouponAssignmentStatus {
  ACTIVE
  EXHAUSTED
  EXPIRED
  REVOKED
}

/** 프로모션 쿠폰 정의 — 정산 수수료 면제/할인 등 */
model Coupon {
  id                 String            @id @default(cuid())
  name               String
  code               String            @unique
  benefitType        CouponBenefitType
  /** FEE_WAIVER: 수수료 면제 대상 매출 한도(원) */
  waiveUpToKrw       Int?
  /** FEE_PERCENT_OFF: 수수료 할인율 (1–100) */
  percentOff         Int?
  /** FIXED_AMOUNT: 수수료에서 차감할 고정 금액 */
  fixedDiscountKrw   Int?
  audience           CouponAudience    @default(SPECIFIC_USERS)
  /** SPECIFIC_TIER 시 SupportTierLevel 또는 PREMIUM 등 */
  targetTier         String?
  /** 유저당 사용 횟수 (null = 무제한) */
  maxUsesPerUser     Int?
  /** 전체 사용 횟수 한도 (null = 무제한) */
  maxTotalUses       Int?
  startsAt           DateTime          @default(now())
  endsAt             DateTime?
  active             Boolean           @default(true)
  adminMemo          String?           @db.Text
  createdById        String
  assignedCount      Int               @default(0)
  usedCount          Int               @default(0)
  /** 적용된 혜택 금액 합(원) */
  usedBenefitKrw     Int               @default(0)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  createdBy   User               @relation("CouponCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assignments CouponAssignment[]
  usages      CouponUsage[]
  history     CouponHistory[]

  @@index([active, endsAt])
  @@index([createdAt])
  @@index([createdById])
  @@index([name])
}

model CouponAssignment {
  id                   String                 @id @default(cuid())
  couponId             String
  userId               String
  assignedById         String?
  status               CouponAssignmentStatus @default(ACTIVE)
  /** FEE_WAIVER 남은 면제 매출 한도 */
  remainingBenefitKrw  Int?
  usedBenefitKrw       Int                    @default(0)
  useCount             Int                    @default(0)
  assignedAt           DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  coupon     Coupon        @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user       User          @relation("CouponAssignee", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy User?         @relation("CouponAssigner", fields: [assignedById], references: [id], onDelete: SetNull)
  usages     CouponUsage[]

  @@unique([couponId, userId])
  @@index([userId, status])
  @@index([couponId, status])
}

model CouponUsage {
  id               String   @id @default(cuid())
  couponId         String
  assignmentId     String
  userId           String
  referenceType    String
  referenceId      String?
  grossAmountKrw   Int
  benefitAppliedKrw Int
  feeBeforeKrw     Int
  feeAfterKrw      Int
  note             String?
  createdAt        DateTime @default(now())

  coupon     Coupon           @relation(fields: [couponId], references: [id], onDelete: Cascade)
  assignment CouponAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user       User             @relation("CouponUsageUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([couponId, createdAt])
  @@index([userId, createdAt])
  @@index([assignmentId, createdAt])
  @@index([referenceType, referenceId])
}

model CouponHistory {
  id        String   @id @default(cuid())
  couponId  String
  actorId   String?
  action    String
  detail    String?  @db.Text
  metadata  Json?
  createdAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@index([couponId, createdAt])
}

// ============ PROMOTION (auto-applied, no code) ============

enum PromotionTrigger {
  MANUAL
  ON_SIGNUP
  ON_FIRST_LIVE
  ON_FIRST_SALE
  ON_EVENT
  SCHEDULED_DATE
  CRON_RULE
}

enum PromotionAssignmentStatus {
  ACTIVE
  EXHAUSTED
  EXPIRED
  REVOKED
}

/** 코드 없이 계정에 귀속되어 정산 시 자동 적용되는 혜택 */
model Promotion {
  id                String            @id @default(cuid())
  name              String
  slug              String            @unique
  description       String?           @db.Text
  benefitType       CouponBenefitType
  waiveUpToKrw      Int?
  percentOff        Int?
  fixedDiscountKrw  Int?
  /** 낮을수록 우선 적용 (1 = 최우선) */
  priority          Int               @default(100)
  /** 다른 Promotion과 스택(동시 적용) 가능 여부 */
  stackable         Boolean           @default(false)
  /** 동일 Promotion 중복 적용 허용 (보통 false) */
  allowDuplicate    Boolean           @default(false)
  /** 한 정산에 Promotion 스택 최대 개수 (전역 상한과 min) */
  maxStackPerSettlement Int           @default(1)
  trigger           PromotionTrigger  @default(MANUAL)
  /** 조건부 지급 규칙 JSON 배열 [{type,value}] */
  rules             Json?
  /** SCHEDULED_DATE / CRON 예약 */
  scheduledAt       DateTime?
  startsAt          DateTime          @default(now())
  endsAt            DateTime?
  active            Boolean           @default(true)
  maxUsesPerUser    Int?
  maxTotalUses      Int?
  adminMemo         String?           @db.Text
  createdById       String
  assignedCount     Int               @default(0)
  usedCount         Int               @default(0)
  usedBenefitKrw    Int               @default(0)
  /** 만료 알림 발송 플래그 (7/3/1일) */
  expiryNotified7d  Boolean           @default(false)
  expiryNotified3d  Boolean           @default(false)
  expiryNotified1d  Boolean           @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  createdBy   User                   @relation("PromotionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assignments PromotionAssignment[]
  usages      PromotionUsage[]
  history     PromotionHistory[]

  @@index([active, priority])
  @@index([trigger, active])
  @@index([endsAt])
  @@index([createdAt])
}

model PromotionAssignment {
  id                  String                     @id @default(cuid())
  promotionId         String
  userId              String
  assignedById        String?
  status              PromotionAssignmentStatus  @default(ACTIVE)
  remainingBenefitKrw Int?
  usedBenefitKrw      Int                        @default(0)
  useCount            Int                        @default(0)
  assignedAt          DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  promotion  Promotion         @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  user       User              @relation("PromotionAssignee", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy User?             @relation("PromotionAssigner", fields: [assignedById], references: [id], onDelete: SetNull)
  usages     PromotionUsage[]

  @@unique([promotionId, userId])
  @@index([userId, status])
  @@index([promotionId, status])
}

model PromotionUsage {
  id                String   @id @default(cuid())
  promotionId       String
  assignmentId      String
  userId            String
  referenceType     String
  referenceId       String?
  grossAmountKrw    Int
  benefitAppliedKrw Int
  feeBeforeKrw      Int
  feeAfterKrw       Int
  note              String?
  createdAt         DateTime @default(now())

  promotion  Promotion           @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  assignment PromotionAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user       User                @relation("PromotionUsageUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([promotionId, createdAt])
  @@index([userId, createdAt])
  @@index([referenceType, referenceId])
}

model PromotionHistory {
  id          String   @id @default(cuid())
  promotionId String
  actorId     String?
  action      String
  detail      String?  @db.Text
  metadata    Json?
  createdAt   DateTime @default(now())

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@index([promotionId, createdAt])
}

// ============ SETTLEMENT LEDGER (확장형 정산) ============

enum SettlementStatus {
  PENDING
  REVIEW
  APPROVED
  REJECTED
  PROCESSING
  PAID
  FAILED
  CANCELLED
}

enum SettlementItemType {
  TIP
  EMOTICON
  DIGITAL_PRODUCT
  GOODS
  AD
  LIVE
  PLATFORM_FEE
  PROMOTION_DISCOUNT
  COUPON_DISCOUNT
  PAYOUT
  OTHER
}

model Settlement {
  id               String           @id @default(cuid())
  userId           String
  status           SettlementStatus @default(PENDING)
  periodStart      DateTime?
  periodEnd        DateTime?
  grossAmountKrw   Int              @default(0)
  feeAmountKrw     Int              @default(0)
  discountAmountKrw Int             @default(0)
  netAmountKrw     Int              @default(0)
  currency         String           @default("usd")
  title            String?
  note             String?          @db.Text
  decidedById      String?
  decidedAt        DateTime?
  paidAt           DateTime?
  payoutRequestId  String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  user      User                @relation("SettlementUser", fields: [userId], references: [id], onDelete: Cascade)
  decidedBy User?               @relation("SettlementDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  items     SettlementItem[]
  history   SettlementHistory[]

  @@index([userId, status])
  @@index([status, createdAt])
  @@index([createdAt])
}

model SettlementItem {
  id            String             @id @default(cuid())
  settlementId  String
  type          SettlementItemType
  label         String
  amountKrw     Int
  referenceType String?
  referenceId   String?
  metadata      Json?
  createdAt     DateTime           @default(now())

  settlement Settlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  @@index([settlementId])
  @@index([type])
}

model SettlementHistory {
  id           String            @id @default(cuid())
  settlementId String
  actorId      String?
  action       String
  fromStatus   SettlementStatus?
  toStatus     SettlementStatus?
  detail       String?           @db.Text
  metadata     Json?
  createdAt    DateTime          @default(now())

  settlement Settlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  @@index([settlementId, createdAt])
}

/**
 * 불변 정산 원장 — 금액 변화는 append-only.
 * 수정·삭제 금지 (애플리케이션 레벨).
 */
model SettlementLedgerEntry {
  id            String   @id @default(cuid())
  settlementId  String?
  userId        String
  /** TIP | PROMOTION | COUPON | PLATFORM_FEE | PAYOUT | ADJUSTMENT | OTHER */
  entryType     String
  label         String
  /** 부호 있는 금액 (원). 수익 +, 차감 - */
  amountKrw     Int
  balanceAfterKrw Int?
  referenceType String?
  referenceId   String?
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([settlementId, createdAt])
  @@index([userId, createdAt])
  @@index([entryType, createdAt])
}

/** 플랫폼 Wallet (MOCO 포인트 · 크레딧) — 현금 정산과 분리 */
model PlatformWallet {
  id              String   @id @default(cuid())
  userId          String   @unique
  mocoPoints      Int      @default(0)
  siteCreditKrw   Int      @default(0)
  promoCreditKrw  Int      @default(0)
  refundCreditKrw Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user    User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledgers PlatformWalletLedger[]
}

model PlatformWalletLedger {
  id            String   @id @default(cuid())
  walletId      String
  /** MOCO_POINTS | SITE_CREDIT | PROMO_CREDIT | REFUND_CREDIT */
  bucket        String
  delta         Int
  balanceAfter  Int
  reason        String
  referenceType String?
  referenceId   String?
  metadata      Json?
  createdAt     DateTime @default(now())

  wallet PlatformWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
  @@index([bucket, createdAt])
}

/** 재배포 없이 ON/OFF — Feature Flag */
model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  enabled     Boolean  @default(true)
  description String?
  metadata    Json?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([enabled])
}

/** 일반화 Scheduler 작업 정의 */
model ScheduledJob {
  id          String    @id @default(cuid())
  name        String    @unique
  /** promotions.expiry | promotions.assign | settlements.stats | mail.digest | custom */
  jobType     String
  cronExpr    String?
  payload     Json?
  enabled     Boolean   @default(true)
  lastRunAt   DateTime?
  lastStatus  String?
  lastError   String?   @db.Text
  nextRunAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  runs ScheduledJobRun[]

  @@index([enabled, nextRunAt])
  @@index([jobType])
}

model ScheduledJobRun {
  id        String   @id @default(cuid())
  jobId     String
  status    String
  detail    String?  @db.Text
  startedAt DateTime @default(now())
  finishedAt DateTime?

  job ScheduledJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, startedAt])
}

/** 멀티채널 알림 발송 기록 (IN_APP / EMAIL / PUSH / WEBHOOK) */
model NotificationDelivery {
  id             String   @id @default(cuid())
  notificationId String?
  userId         String?
  channel        String
  status         String   @default("PENDING")
  payload        Json?
  error          String?  @db.Text
  createdAt      DateTime @default(now())
  sentAt         DateTime?

  @@index([channel, status, createdAt])
  @@index([userId, createdAt])
  @@index([notificationId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, endpoint])
  @@index([userId])
}

/** FCM/APNs 네이티브 디바이스 토큰 */
model MobilePushToken {
  id        String   @id @default(cuid())
  userId    String
  token     String
  platform  String   // android | ios
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, token])
  @@index([userId])
  @@index([token])
}

/** Opaque refresh tokens for React Native Bearer auth (hash only). */
model MobileRefreshToken {
  id           String    @id @default(cuid())
  userId       String
  tokenHash    String    @unique
  deviceId     String?
  platform     String?   // android | ios
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  actorId   String?
  type      String
  title     String
  body      String?
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, read, createdAt])
  @@index([userId, createdAt])
}

// ============ 크리에이터 작품 (웹툰·사진·영상 판매) ============

enum CreatorWorkKind {
  WEBTOON
  PHOTO
  VIDEO
}

enum WebtoonPublishDay {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

enum WebtoonGenre {
  SCHOOL
  ACTION
  SF
  STORY
  FANTASY
  BL_GL
  COMEDY
  PURE_LOVE
  DRAMA
  ROMANCE
  HISTORICAL
  SPORTS
  SLICE_OF_LIFE
  MYSTERY
  HORROR
  ADULT
  OMNIBUS
  EPISODE
  MARTIAL_ARTS
  SHONEN
  OTHER
}

model CreatorSeries {
  id          String             @id @default(cuid())
  authorId    String
  title       String
  description String?            @db.Text
  coverUrl    String
  kind        CreatorWorkKind
  publishDay  WebtoonPublishDay?
  genre       WebtoonGenre?
  status      String             @default("ONGOING")
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  author   User             @relation("CreatorSeriesAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  episodes CreatorEpisode[]

  @@index([authorId, createdAt(sort: Desc)])
  @@index([kind, createdAt(sort: Desc)])
  @@index([kind, publishDay])
  @@index([kind, genre])
}

model CreatorEpisode {
  id               String          @id @default(cuid())
  seriesId         String
  authorId         String
  title            String
  episodeNo        Int
  price            Int             @default(0)
  previewUrls      Json            @default("[]")
  contentUrls      Json            @default("[]")
  videoUrl         String?
  freePreviewCount Int             @default(1)
  salesCount       Int             @default(0)
  viewCount        Int             @default(0)
  published        Boolean         @default(true)
  scheduledAt      DateTime?
  publishedAt      DateTime?
  createdAt        DateTime        @default(now())

  series    CreatorSeries            @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  author    User                     @relation("CreatorEpisodeAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  purchases CreatorEpisodePurchase[]
  watermarkSessions WatermarkSession[]

  @@unique([seriesId, episodeNo])
  @@index([seriesId, episodeNo])
}

model CreatorEpisodePurchase {
  id        String   @id @default(cuid())
  buyerId   String
  episodeId String
  price     Int
  createdAt DateTime @default(now())

  buyer   User           @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  episode CreatorEpisode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  watermarkSessions WatermarkSession[]

  @@unique([buyerId, episodeId])
  @@index([buyerId, createdAt(sort: Desc)])
}

// ============ 웹툰 드로잉 스튜디오 (클라우드) ============

model WebtoonStudioProject {
  id        String   @id @default(cuid())
  userId    String
  name      String
  data      Json
  favorite  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt(sort: Desc)])
  @@index([userId, favorite])
}

model WebtoonStudioSettings {
  userId    String   @id
  brushes   Json     @default("[]")
  palette   Json     @default("[]")
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============ VIRTUAL AVATAR STUDIO ============

model AvatarPreset {
  id        String   @id @default(cuid())
  userId    String   @unique
  name      String   @default("기본")
  config    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============ APT (아파트 생활 시뮬레이션) ============

model AptProfile {
  id                String    @id @default(cuid())
  userId            String    @unique
  moveInCompletedAt DateTime?
  housingType       String    @default("apartment")
  countryCode       String    @default("KR")
  latitude          Float?
  longitude         Float?
  regionLabel       String?
  homeFloor         Int       @default(50)
  floorPlans        Json      @default("{}")
  furniture         Json      @default("[]")
  residents         Json      @default("[]")
  simulationState   Json      @default("{}")
  houseBuild        Json      @default("{}")
  homePublic        Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/** 스티커 다이오라마 방별 배치 — 기기 간 동기화 */
model AptDioramaLayout {
  id        String   @id @default(cuid())
  userId    String
  roomId    String
  instances Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roomId])
  @@index([userId])
}

/** APT 집 방문 기록 — 방명록·랭킹·커뮤니티 통계 */
model AptHomeVisit {
  id        String   @id @default(cuid())
  hostId    String
  visitorId String
  createdAt DateTime @default(now())

  host    User @relation("AptVisitHost", fields: [hostId], references: [id], onDelete: Cascade)
  visitor User @relation("AptVisitVisitor", fields: [visitorId], references: [id], onDelete: Cascade)

  @@index([hostId, createdAt(sort: Desc)])
  @@index([visitorId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}

/** APT 실시간 접속 — 로비·광장·복도 아바타 표시 */
model AptPresence {
  userId         String   @id
  countryCode    String   @default("KR")
  mode           String   @default("district")
  homeFloor      Int      @default(50)
  visitingUserId String?
  lastSeenAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([countryCode, lastSeenAt(sort: Desc)])
  @@index([mode, countryCode, lastSeenAt(sort: Desc)])
  @@index([visitingUserId, lastSeenAt(sort: Desc)])
}

/** APT 집 좋아요 — 오늘의 집·주간 베스트 룸 집계 */
model AptHomeLike {
  id        String   @id @default(cuid())
  hostId    String
  likerId   String
  createdAt DateTime @default(now())

  host  User @relation("AptHomeLikeHost", fields: [hostId], references: [id], onDelete: Cascade)
  liker User @relation("AptHomeLiker", fields: [likerId], references: [id], onDelete: Cascade)

  @@unique([hostId, likerId])
  @@index([hostId, createdAt(sort: Desc)])
  @@index([likerId, createdAt(sort: Desc)])
}

/** APT 즐겨찾는 집 / 이웃 */
model AptFavoriteHome {
  id        String   @id @default(cuid())
  userId    String
  hostId    String
  createdAt DateTime @default(now())

  user User @relation("AptFavoriteOwner", fields: [userId], references: [id], onDelete: Cascade)
  host User @relation("AptFavoriteHost", fields: [hostId], references: [id], onDelete: Cascade)

  @@unique([userId, hostId])
  @@index([userId, createdAt(sort: Desc)])
}

/** APT 동거 신청 — 집주인 알림창에서 수락/거절 */
model AptCohabitationRequest {
  id          String    @id @default(cuid())
  requesterId String
  hostId      String
  roomId      String?
  status      String    @default("PENDING")
  message     String?   @db.Text
  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  requester User @relation("AptCohabRequestRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  host      User @relation("AptCohabRequestHost", fields: [hostId], references: [id], onDelete: Cascade)

  @@index([hostId, status, createdAt(sort: Desc)])
  @@index([requesterId, status, createdAt(sort: Desc)])
}

/** APT 동거자 — 기본 최대 2명 거주, 동거자는 집주인 빈 방에 연결 */
model AptCohabitant {
  id              String    @id @default(cuid())
  hostId          String
  residentId      String
  roomId          String
  status          String    @default("ACTIVE")
  movedInAt       DateTime  @default(now())
  moveOutRequestedById String?
  moveOutRequestedAt DateTime?
  endedAt         DateTime?

  host     User @relation("AptCohabHost", fields: [hostId], references: [id], onDelete: Cascade)
  resident User @relation("AptCohabResident", fields: [residentId], references: [id], onDelete: Cascade)

  @@unique([residentId])
  @@index([hostId, status])
  @@index([residentId, status])
}

/** APT 게임 경제 — 골드·젬 (크리에이터 Wallet과 분리) */
model AptWallet {
  userId        String   @id
  gold          Int      @default(0)
  gems          Int      @default(0)
  legacyMigrated Boolean @default(false)
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/** APT 인벤토리 — 보유 아이템 (가구·벽지·장식 등 공통) */
model AptInventoryItem {
  id         String   @id @default(cuid())
  userId     String
  itemId     String
  quantity   Int      @default(1)
  acquiredAt DateTime @default(now())
  /** shop | market | flea | gift | event | starter */
  source     String   @default("shop")
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
  @@index([userId])
}

/** APT 창고 — 배치 가능 수량 (Inventory − 집 배치) */
model AptStorageItem {
  userId    String
  itemId    String
  quantity  Int      @default(0)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, itemId])
  @@index([userId])
}

/** IAP·젬 상점 상품 — Google Play productId 1:1 */
model AptShopProduct {
  id          String   @id @default(cuid())
  slug        String   @unique
  productId   String   @unique
  type        String
  amount      Int
  bonusAmount Int      @default(0)
  priceTier   Int      @default(1)
  title       String
  description String?
  enabled     Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/** 공식 골드 상점 — 추천·한정·할인 */
model AptGoldShopOffer {
  id                String    @id @default(cuid())
  itemId            String    @unique
  goldPrice         Int
  originalGoldPrice Int?
  featured          Boolean   @default(false)
  isNew             Boolean   @default(false)
  limitedStock      Int?
  soldCount         Int       @default(0)
  startsAt          DateTime?
  endsAt            DateTime?
  enabled           Boolean   @default(true)
  sortOrder         Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([enabled, featured, sortOrder])
  changeLogs AptGoldShopOfferChangeLog[]
}

/** Gold Shop 상품 변경 이력 */
model AptGoldShopOfferChangeLog {
  id        String   @id @default(cuid())
  offerId   String
  itemId    String
  adminId   String
  field     String
  before    String
  after     String
  createdAt DateTime @default(now())
  offer     AptGoldShopOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  admin     User     @relation("AptGoldShopOfferChanges", fields: [adminId], references: [id], onDelete: Cascade)

  @@index([offerId, createdAt(sort: Desc)])
  @@index([itemId, createdAt(sort: Desc)])
}

/** 벼룩시장 이벤트 — 일반 장터 위 레이어 */
model AptFleaEvent {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String?
  notice      String?
  bannerUrl   String?
  startsAt    DateTime
  endsAt      DateTime
  feeRate     Float    @default(0.05)
  active      Boolean  @default(true)
  published   Boolean  @default(false)
  visitCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  listings   AptMarketListing[]
  npcOffers  AptFleaNpcOffer[]
  changeLogs AptFleaEventChangeLog[]

  @@index([active, published, startsAt, endsAt])
}

/** 벼룩시장 NPC 상품 — 운영자가 이벤트마다 판매/매입 설정 */
model AptFleaNpcOffer {
  id              String   @id @default(cuid())
  eventId         String
  kind            String
  stickerTypeId   String
  goldPrice       Int
  discountPercent Int?
  stock           Int?
  soldCount       Int      @default(0)
  boughtCount     Int      @default(0)
  enabled         Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  event AptFleaEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, enabled, sortOrder])
}

/** 벼룩시장 이벤트 변경 이력 */
model AptFleaEventChangeLog {
  id        String   @id @default(cuid())
  eventId   String
  adminId   String
  field     String
  before    String
  after     String
  createdAt DateTime @default(now())
  event     AptFleaEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  admin     User     @relation("AptFleaEventChanges", fields: [adminId], references: [id], onDelete: Cascade)

  @@index([eventId, createdAt(sort: Desc)])
}

/** APT 경제 설정 — 버전·긴급 모드 포함 */
model AptEconomyConfig {
  id                    String    @id @default("default")
  version               Int       @default(1)
  publishedAt           DateTime?
  publishedById         String?

  goldPerGem            Int       @default(100)
  bonusRate             Float     @default(0)
  dailyGemExchangeLimit Int       @default(10000)
  dailyGoldLimit        Int       @default(50000)
  marketFee             Float     @default(0.05)
  npcBuyRate            Float     @default(0.65)
  npcSellRate           Float     @default(0.70)
  starterGold           Int       @default(500)

  liveGoldPerCheer      Int       @default(2)
  dailyLiveGoldLimit    Int       @default(5000)
  liveWatchGoldPerMin   Int       @default(15)
  dailyWatchGoldLimit   Int       @default(3000)

  dailyMissionReward    Int       @default(80)
  weeklyMissionReward   Int       @default(400)

  featuredRefreshHour   Int       @default(0)
  newItemDays           Int       @default(7)
  discountDefaultRate   Float     @default(0.20)

  recommendPriceWindow  Int       @default(20)
  maxListingDays        Int       @default(30)
  priceHistoryDays      Int       @default(90)

  defaultFleaFee        Float     @default(0.05)
  defaultFleaDiscount   Float     @default(0.30)
  fleaEventCooldownHrs  Int       @default(168)

  pendingExpireDays     Int       @default(30)
  maxOfflineOps         Int       @default(100)

  emergencyMode         Boolean   @default(false)

  fraudRestrictScore    Int       @default(70)
  fraudMarketBlockScore Int       @default(90)
  fraudLiveBlockScore   Int       @default(95)

  updatedAt             DateTime  @updatedAt
  publishedBy           User?     @relation("AptEconomyConfigPublisher", fields: [publishedById], references: [id], onDelete: SetNull)
}

/** Economy Config 변경 감사 */
model AptEconomyConfigChangeLog {
  id         String   @id @default(cuid())
  adminId    String
  field      String
  before     String
  after      String
  reason     String?
  ip         String?
  version    Int?
  createdAt  DateTime @default(now())
  admin      User     @relation("AptEconomyConfigChanges", fields: [adminId], references: [id], onDelete: Cascade)

  @@index([createdAt(sort: Desc)])
  @@index([field, createdAt(sort: Desc)])
  @@index([version, createdAt(sort: Desc)])
}

/** 경제 기능 Kill Switch — 기능별 ON/OFF (Emergency보다 세분화) */
model AptEconomyFeatureFlag {
  id                  String   @id @default("default")
  shopEnabled         Boolean  @default(true)
  marketEnabled       Boolean  @default(true)
  liveEnabled         Boolean  @default(true)
  missionEnabled      Boolean  @default(true)
  notificationEnabled Boolean  @default(true)
  fleaEnabled         Boolean  @default(true)
  iapEnabled          Boolean  @default(true)
  updatedAt           DateTime @updatedAt
  updatedById         String?
  updatedBy           User?    @relation("AptEconomyFeatureFlagUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
}

/** Feature Flag 변경 감사 */
model AptEconomyFeatureFlagLog {
  id        String   @id @default(cuid())
  adminId   String
  feature   String
  before    String
  after     String
  reason    String?
  ip        String?
  createdAt DateTime @default(now())
  admin     User     @relation("AptEconomyFeatureFlagLogs", fields: [adminId], references: [id], onDelete: Cascade)

  @@index([createdAt(sort: Desc)])
  @@index([feature, createdAt(sort: Desc)])
}

/** 경제 전체 스냅샷 — 운영 복구용 */
model AptEconomySnapshot {
  id          String   @id @default(cuid())
  label       String
  type        String
  stats       Json
  payload     Json
  checksum    String
  createdAt   DateTime @default(now())
  createdById String?
  createdBy   User?    @relation("AptEconomySnapshotCreator", fields: [createdById], references: [id], onDelete: SetNull)
  restores    AptEconomyRestoreLog[]

  @@index([type, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}

/** Canary 점진 배포 — 경제 변경 실험 */
model AptEconomyCanary {
  id                 String    @id @default(cuid())
  targetType         String
  targetId           String    @default("default")
  stage              String    @default("DRAFT")
  percent            Int       @default(0)
  operatorUserIds    Json      @default("[]")
  testerUserIds      Json      @default("[]")
  draftPayload       Json
  reason             String?
  publishedVersion   Int?
  rollbackSnapshotId String?
  correlationId      String?
  autoRollback       Boolean   @default(true)
  createdById        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  startedAt          DateTime?
  completedAt        DateTime?

  createdBy     User?                        @relation("AptEconomyCanaryCreator", fields: [createdById], references: [id], onDelete: SetNull)
  logs          AptEconomyCanaryLog[]
  healthMetrics AptEconomyCanaryHealthMetric[]

  @@index([targetType, targetId, completedAt])
  @@index([stage, updatedAt(sort: Desc)])
}

/** Canary 단계 변경 감사 */
model AptEconomyCanaryLog {
  id            String   @id @default(cuid())
  canaryId      String
  adminId       String?
  action        String
  fromStage     String?
  toStage       String?
  fromPercent   Int?
  toPercent     Int?
  correlationId String
  reason        String?
  metadata      Json?
  createdAt     DateTime @default(now())

  canary AptEconomyCanary @relation(fields: [canaryId], references: [id], onDelete: Cascade)
  admin  User?            @relation("AptEconomyCanaryAdmin", fields: [adminId], references: [id], onDelete: SetNull)

  @@index([canaryId, createdAt(sort: Desc)])
  @@index([correlationId])
  @@index([createdAt(sort: Desc)])
}

/** Canary Health Monitor 연계 메트릭 */
model AptEconomyCanaryHealthMetric {
  id                 String   @id @default(cuid())
  canaryId           String
  windowStart        DateTime
  windowEnd          DateTime
  walletErrors       Int      @default(0)
  marketErrors       Int      @default(0)
  marketOps          Int      @default(0)
  notificationErrors Int      @default(0)
  fraudBaseline      Int      @default(0)
  fraudCurrent       Int      @default(0)
  goldSupplyBaseline Int      @default(0)
  goldSupplyCurrent  Int      @default(0)
  rollbackCount      Int      @default(0)
  createdAt          DateTime @default(now())

  canary AptEconomyCanary @relation(fields: [canaryId], references: [id], onDelete: Cascade)

  @@index([canaryId, windowEnd(sort: Desc)])
}

/** Health Monitor — Alert Rule */
model AptEconomyHealthRule {
  id          String   @id @default(cuid())
  code        String   @unique
  domain      String
  label       String
  metric      String
  operator    String   @default("gt")
  threshold   Float
  severity    String   @default("WARN")
  autoAction  String   @default("NONE")
  enabled     Boolean  @default(true)
  sortOrder   Int      @default(0)
  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   User?    @relation("AptEconomyHealthRuleUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  alerts      AptEconomyHealthAlert[]

  @@index([domain, enabled])
}

/** Health Monitor — Alert 이력 */
model AptEconomyHealthAlert {
  id            String    @id @default(cuid())
  ruleId        String
  ruleCode      String
  domain        String
  severity      String
  status        String    @default("OPEN")
  message       String
  metricValue   Float?
  threshold     Float?
  correlationId String
  autoAction    String?
  autoActionOk  Boolean?
  resolvedAt    DateTime?
  resolvedById  String?
  createdAt     DateTime  @default(now())

  rule       AptEconomyHealthRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  resolvedBy User?                @relation("AptEconomyHealthAlertResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt(sort: Desc)])
  @@index([domain, createdAt(sort: Desc)])
  @@index([correlationId])
  @@index([ruleCode, createdAt(sort: Desc)])
}

/** Health Monitor — 시간대별 스냅샷 (Heatmap) */
model AptEconomyHealthSnapshot {
  id        String   @id @default(cuid())
  hour      DateTime
  domain    String
  score     Int
  metrics   Json
  createdAt DateTime @default(now())

  @@unique([hour, domain])
  @@index([hour(sort: Desc)])
}

/** Restore 감사 로그 */
model AptEconomyRestoreLog {
  id            String   @id @default(cuid())
  snapshotId    String
  adminId       String
  correlationId String
  scopes        Json
  dryRun        Boolean  @default(false)
  reason        String
  stats         Json
  createdAt     DateTime @default(now())
  snapshot      AptEconomySnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  admin         User     @relation("AptEconomyRestoreAdmin", fields: [adminId], references: [id], onDelete: Cascade)

  @@index([snapshotId, createdAt(sort: Desc)])
  @@index([correlationId])
  @@index([createdAt(sort: Desc)])
}

/** 부정행위 위험 프로필 */
model AptFraudProfile {
  userId           String    @id
  riskScore        Int       @default(0)
  lastCalculatedAt DateTime?
  status           String    @default("NORMAL")
  reasonSummary    String?
  whitelistedUntil DateTime?
  frozenAt         DateTime?
  restrictions     Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([riskScore(sort: Desc)])
  @@index([status, riskScore(sort: Desc)])
}

/** 부정행위 탐지 규칙 — weight·threshold 운영 조정 */
model AptFraudRule {
  id          String   @id
  label       String
  weight      Int      @default(30)
  enabled     Boolean  @default(true)
  threshold   Json?
  description String?
  updatedAt   DateTime @updatedAt
}

/** Fraud Rule 버전 메타 */
model AptFraudRuleMeta {
  id            String    @id @default("default")
  version       Int       @default(1)
  publishedAt   DateTime?
  publishedById String?
  publishedBy   User?     @relation("AptFraudRulePublisher", fields: [publishedById], references: [id], onDelete: SetNull)
}

/** Fraud Rule 변경 감사 */
model AptFraudRuleChangeLog {
  id        String   @id @default(cuid())
  adminId   String
  ruleId    String?
  field     String
  before    String
  after     String
  reason    String?
  ip        String?
  version   Int?
