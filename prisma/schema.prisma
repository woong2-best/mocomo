  MISSING_PARTS
  SELLER_NO_RESPONSE
  OTHER
}

enum MarketplaceReportReason {
  FRAUD
  COUNTERFEIT
  COPYRIGHT
  ILLEGAL
  SPAM
  ADULT
  OTHER
}

enum MarketplaceShipmentStatus {
  PREPARING
  SHIPPED
  IN_CUSTOMS
  IN_TRANSIT
  DELIVERED
}

enum MarketplaceRefundStatus {
  REQUESTED
  SELLER_REVIEW
  APPROVED
  REJECTED
  COMPLETED
}

enum MarketplaceDisputeStatus {
  OPEN
  EVIDENCE
  REVIEWING
  RESOLVED_BUYER
  RESOLVED_SELLER
  CLOSED
}

model MarketplaceSellerProfile {
  id              String                   @id @default(cuid())
  userId          String                   @unique
  displayName     String
  bio             String?                  @db.Text
  snsLinks        Json?
  status          MarketplaceSellerStatus  @default(PENDING)
  /** Seller onboarding (MoCoMo MARKET / WING-style) */
  sellerType      MarketplaceSellerType?
  sellingMarket   String                   @default("KR")
  businessName    String?
  businessRegNo   String?
  /** 사업자 대표자명 (국세청 진위확인) */
  businessRepresentativeName String?
  /** 개업일자 YYYYMMDD (국세청 진위확인) */
  businessStartDate String?
  /** 국세청 사업자 확인 완료 시각 */
  businessVerifiedAt DateTime?
  /** 납세자상태 코드: 01 계속, 02 휴업, 03 폐업 */
  businessStatusCode String?
  /** 과세유형 (국세청 상태조회) */
  businessTaxType String?
  onboardingStep  MarketplaceSellerOnboardingStep @default(ACCOUNT)
  onboardingCompletedAt DateTime?
  agreedAgeAt       DateTime?
  agreedTermsAt     DateTime?
  agreedPrivacyAt   DateTime?
  agreedMarketingAt DateTime?
  agreedPromoAt     DateTime?
  kycStatus         MarketplaceSellerKycStatus @default(NOT_STARTED)
  kycSubmittedAt    DateTime?
  kycNotes          String?                @db.Text
  /** KYC 신분증 유형 — NATIONAL_ID / PASSPORT / DRIVERS_LICENSE / RESIDENT_CARD */
  kycIdType         String?
  /** 법적 성명 (KYC 제출) */
  kycLegalName      String?
  /** 신분증 번호 끝자리 등 힌트 (전체 번호 저장 금지) */
  kycIdHint         String?
  /** KYC 신분증 이미지 — 비공개 스토리지 키 (공개 URL 저장 금지) */
  kycDocumentKey    String?
  /** Stripe Connect 온보딩 시작(해외: SMS 대신 Connect 선행) */
  stripeConnectStartedAt DateTime?
  /** 은행 계좌 등록/검토 요청 완료 */
  settlementDeclaredAt DateTime?
  phoneCountryCode  String?
  ratingAvg       Float                    @default(0)
  ratingCount     Int                      @default(0)
  salesCount      Int                      @default(0)
  followerCount   Int                      @default(0)
  responseRate    Float?
  avgShipDays     Float?
  /** Trust & protection */
  trustScore      Float                    @default(50)
  trustTier       MarketplaceTrustTier     @default(NEW)
  sanctionLevel   MarketplaceSanctionLevel @default(NONE)
  reportCount     Int                      @default(0)
  confirmedOrderCount Int                  @default(0)
  refundedOrderCount  Int                  @default(0)
  disputedOrderCount  Int                  @default(0)
  lateShipCount       Int                  @default(0)
  canList             Boolean              @default(true)
  settlementBlocked   Boolean              @default(false)
  returnCountry   String?
  returnPostal    String?
  returnAddress1  String?
  returnAddress2  String?
  returnPhone     String?
  applyReason     String?                  @db.Text
  reviewedAt      DateTime?
  reviewedById    String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  user     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  listings MarketplaceListing[]
  orders   MarketplaceOrder[]   @relation("MarketplaceSellerOrders")
  sanctions MarketplaceSanction[]
  reports   MarketplaceReport[] @relation("MarketplaceReportSeller")

  @@index([status, createdAt])
  @@index([trustTier, trustScore])
  @@index([sanctionLevel])
  @@index([onboardingStep, status])
  @@index([sellerType, status])
}

model MarketplaceListing {
  id                 String                     @id @default(cuid())
  sellerId           String
  sellerProfileId    String?
  title              String
  description        String                     @db.Text
  type               MarketplaceListingType
  category           String
  tags               String[]
  priceAmount        Int
  currency           String                     @default("usd")
  stock              Int                        @default(1)
  options            Json?
  status             MarketplaceListingStatus   @default(DRAFT)
  coverUrl           String?
  productionDays     Int?
  digitalFileUrl     String?
  digitalDownloadLimit Int?
  digitalExpiresDays Int?
  shipsWorldwide     Boolean                    @default(false)
  /** Supported buyer destinations — subset of MARKETPLACE_SHIP_COUNTRY_CODES */
  shipToCountries    String[]
  shippingMethods    String[]
  shippingFeeType    MarketplaceShippingFeeType @default(FIXED)
  shippingFeeFixed   Int                        @default(0)
  freeShippingOver   Int?
  viewCount          Int                        @default(0)
  favoriteCount      Int                        @default(0)
  salesCount         Int                        @default(0)
  isNsfw             Boolean                    @default(false)
  publishedAt        DateTime?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  seller        User                      @relation("MarketplaceSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  sellerProfile MarketplaceSellerProfile? @relation(fields: [sellerProfileId], references: [id], onDelete: SetNull)
  media         MarketplaceListingMedia[]
  favorites     MarketplaceFavorite[]
  orderItems    MarketplaceOrderItem[]
  reviews       MarketplaceReview[]

  @@index([status, type, createdAt])
  @@index([sellerId, status])
  @@index([category, status])
  @@index([priceAmount])
}

model MarketplaceListingMedia {
  id         String   @id @default(cuid())
  listingId  String
  url        String
  type       String   @default("IMAGE")
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  listing MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, sortOrder])
}

model MarketplaceFavorite {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  createdAt DateTime @default(now())

  user    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([listingId])
}

model MarketplaceOrder {
  id                 String                 @id @default(cuid())
  buyerId            String
  sellerId           String
  sellerProfileId    String?
  status             MarketplaceOrderStatus @default(AWAITING_PAYMENT)
  settlementStatus   MarketplaceSettlementStatus @default(PENDING)
  subtotalAmount     Int
  shippingAmount     Int                    @default(0)
  platformFeeAmount  Int                    @default(0)
  sellerEarnAmount   Int                    @default(0)
  currency           String                 @default("usd")
  stripePaymentIntentId String?
  stripeCheckoutSessionId String?
  /** Stripe Transfer id after escrow release */
  stripeTransferId   String?
  escrowHeld         Boolean                @default(true)
  settledAt          DateTime?
  settlementHeldReason String?
  autoConfirmAt      DateTime?
  confirmedAt        DateTime?
  cancelledAt        DateTime?
  riskScore          Int                    @default(0)
  riskFlags          String[]
  adminReviewRequired Boolean               @default(false)
  shipName           String?
  shipCountry        String?
  shipPostal         String?
  shipAddress1       String?
  shipAddress2       String?
  shipPhone          String?
  buyerNote          String?                @db.Text
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  buyer         User                     @relation("MarketplaceBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  seller        User                     @relation("MarketplaceOrderSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  sellerProfile MarketplaceSellerProfile? @relation("MarketplaceSellerOrders", fields: [sellerProfileId], references: [id], onDelete: SetNull)
  items         MarketplaceOrderItem[]
  shipment      MarketplaceShipment?
  refunds       MarketplaceRefund[]
  disputes      MarketplaceDispute[]
  review        MarketplaceReview?
  auditLogs     MarketplaceAuditLog[]

  @@index([buyerId, createdAt])
  @@index([sellerId, status, createdAt])
  @@index([status, autoConfirmAt])
  @@index([settlementStatus, confirmedAt])
  @@index([adminReviewRequired, createdAt])
}

model MarketplaceOrderItem {
  id              String   @id @default(cuid())
  orderId         String
  listingId       String
  titleSnapshot   String
  optionSnapshot  Json?
  unitPrice       Int
  quantity        Int      @default(1)
  listingType     MarketplaceListingType

  order   MarketplaceOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  listing MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Restrict)

  @@index([listingId])
  @@index([orderId])
}

model MarketplaceShipment {
  id             String                   @id @default(cuid())
  orderId        String                   @unique
  /** Display label (e.g. CJ대한통운) */
  carrier        String?
  /** Config carrier id (e.g. KR_CJ) — maps to trackingSlug for future APIs */
  carrierCode    String?
  trackingNumber String?
  /** External provider tracking id (AfterShip etc.) */
  externalTrackingId String?
  /** Optional shipping proof URLs (parcel / label / packing photos) */
  proofUrls      String[]
  packingNote    String?                  @db.Text
  status         MarketplaceShipmentStatus @default(PREPARING)
  shippedAt      DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  order MarketplaceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([trackingNumber])
  @@index([carrierCode])
}

model MarketplaceRefund {
  id          String                  @id @default(cuid())
  orderId     String
  requesterId String
  reason      String                  @db.Text
  status      MarketplaceRefundStatus @default(REQUESTED)
  amount      Int
  stripeRefundId String?
  decidedAt   DateTime?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  order MarketplaceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, status])
}

model MarketplaceDispute {
  id          String                   @id @default(cuid())
  orderId     String
  openerId    String
  reason      String
  reasonCode  MarketplaceDisputeReason @default(OTHER)
  evidence    Json?
  buyerEvidence Json?
  sellerEvidence Json?
  status      MarketplaceDisputeStatus @default(OPEN)
  resolution  String?                  @db.Text
  resolvedAt  DateTime?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  order  MarketplaceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  opener User             @relation("MarketplaceDisputeOpener", fields: [openerId], references: [id], onDelete: Cascade)

  @@index([orderId, status])
  @@index([status, createdAt])
}

model MarketplaceReview {
  id        String   @id @default(cuid())
  orderId   String   @unique
  listingId String
  authorId  String
  rating    Int
  body      String?  @db.Text
  mediaUrls String[]
  createdAt DateTime @default(now())

  order   MarketplaceOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  listing MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  author  User               @relation("MarketplaceReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([listingId, createdAt])
  @@index([authorId])
}

model MarketplaceDigitalDownload {
  id              String    @id @default(cuid())
  orderId         String
  orderItemId     String    @unique
  listingId       String
  buyerId         String
  fileUrl         String
  downloadToken   String    @unique @default(cuid())
  downloadCount   Int       @default(0)
  maxDownloads    Int       @default(5)
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())

  @@index([buyerId, createdAt])
  @@index([orderId])
  @@index([downloadToken])
}

/** Immutable marketplace audit trail (append-only) */
model MarketplaceAuditLog {
  id        String   @id @default(cuid())
  orderId   String?
  actorId   String?
  action    String
  detail    String?  @db.Text
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now())

  order MarketplaceOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@index([action, createdAt])
  @@index([actorId, createdAt])
}

model MarketplaceSanction {
  id        String                   @id @default(cuid())
  sellerProfileId String
  level     MarketplaceSanctionLevel
  reason    String                   @db.Text
  actorId   String?
  active    Boolean                  @default(true)
  createdAt DateTime                 @default(now())

  sellerProfile MarketplaceSellerProfile @relation(fields: [sellerProfileId], references: [id], onDelete: Cascade)

  @@index([sellerProfileId, createdAt])
  @@index([active, level])
}

model MarketplaceReport {
  id              String                  @id @default(cuid())
  reporterId      String
  reason          MarketplaceReportReason
  details         String?                 @db.Text
  listingId       String?
  sellerProfileId String?
  sellerUserId    String?
  status          ReportStatus            @default(PENDING)
  createdAt       DateTime                @default(now())

  sellerProfile MarketplaceSellerProfile? @relation("MarketplaceReportSeller", fields: [sellerProfileId], references: [id], onDelete: SetNull)

  @@index([sellerProfileId, status])
  @@index([listingId, status])
  @@index([status, createdAt])
  @@index([reporterId, createdAt])
}

// ============ FLOWER GIFT (cash-value digital gift assets) ============

enum FlowerAssetStatus {
  HELD
  LOCKED
  REDEEMED
  REVOKED
}

enum FlowerLedgerAction {
  PURCHASE
  MINT
  GIFT_OUT
  GIFT_IN
  REDEEM_LOCK
  REDEEM_PAID
  REDEEM_REJECTED
  REFUND
  ADMIN_REVOKE
  ADMIN_RESTORE
}

enum FlowerRedeemStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
  CANCELLED
}

enum FlowerGiftContext {
  LIVE
  POST
  COMMENT
  MESSAGE
  PROFILE
  DIRECT
  OTHER
}

/** Catalog — add new flowers without code changes */
model FlowerType {
  id             String   @id @default(cuid())
  slug           String   @unique
  nameKo         String
  nameEn         String
  emoji          String
  priceKrw       Int
  defaultMessage String   @db.Text
  imageUrl       String?
  animationKey   String?
  sortOrder      Int      @default(0)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  assets     FlowerAsset[]
  purchases  FlowerPurchase[]

  @@index([active, sortOrder])
}

/** One Stripe purchase may mint one or more asset units */
model FlowerPurchase {
  id              String   @id @default(cuid())
  buyerId         String
  flowerTypeId    String
  quantity        Int      @default(1)
  unitPriceKrw    Int
  totalAmountKrw  Int
  paymentIntentId String?  @unique
  idempotencyKey  String   @unique
  createdAt       DateTime @default(now())

  buyer      User        @relation("FlowerPurchaseBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  flowerType FlowerType  @relation(fields: [flowerTypeId], references: [id], onDelete: Restrict)
  assets     FlowerAsset[]

  @@index([buyerId, createdAt])
}

/**
 * Individual digital gift asset — ownership moves on gift/re-gift.
 * Balance = count/sum of HELD assets owned (ledger is the audit truth).
 */
model FlowerAsset {
  id              String            @id @default(cuid())
  flowerTypeId    String
  ownerId         String
  faceValueKrw    Int
  status          FlowerAssetStatus @default(HELD)
  purchaseId      String?
  /** First mint purchase chain root for provenance */
  chainRootId     String?
  lastTransferId  String?
  lockedAt        DateTime?
  redeemedAt      DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  flowerType FlowerType          @relation(fields: [flowerTypeId], references: [id], onDelete: Restrict)
  owner      User                @relation("FlowerAssetOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  purchase   FlowerPurchase?     @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  transfers  FlowerTransfer[]
  redeems    FlowerRedeemRequest[]
  ledger     FlowerLedgerEntry[]

  @@index([ownerId, status])
  @@index([flowerTypeId, status])
  @@index([chainRootId])
  @@index([status, createdAt])
}

/** Gift / re-gift edge — linked list via previousTransferId */
model FlowerTransfer {
  id                 String            @id @default(cuid())
  assetId            String
  fromUserId         String
  toUserId           String
  message            String?           @db.Text
  usedDefaultMessage Boolean           @default(false)
  context            FlowerGiftContext @default(DIRECT)
  contextId          String?
  previousTransferId String?
  idempotencyKey     String            @unique
  createdAt          DateTime          @default(now())

  asset    FlowerAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  fromUser User        @relation("FlowerTransferFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User        @relation("FlowerTransferTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([assetId, createdAt])
  @@index([fromUserId, createdAt])
  @@index([toUserId, createdAt])
  @@index([context, contextId])
}

/** Append-only flower asset ledger (server-only writes) */
model FlowerLedgerEntry {
  id             String             @id @default(cuid())
  userId         String
  assetId        String?
  action         FlowerLedgerAction
  amountKrw      Int
  balanceAfterKrw Int?
  idempotencyKey String             @unique
  referenceType  String?
  referenceId    String?
  metadata       Json?
  createdAt      DateTime           @default(now())

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset FlowerAsset? @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([assetId, createdAt])
  @@index([action, createdAt])
}

model FlowerRedeemRequest {
  id              String             @id @default(cuid())
  assetId         String
  userId          String
  faceValueKrw    Int
  feeBps          Int                @default(1500)
  feeAmountKrw    Int
  netAmountKrw    Int
  status          FlowerRedeemStatus @default(PENDING)
  riskScore       Int                @default(0)
  riskFlags       String[]
  stripeTransferId String?
  idempotencyKey  String             @unique
  adminNote       String?            @db.Text
  decidedById     String?
  decidedAt       DateTime?
  paidAt          DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  asset FlowerAsset @relation(fields: [assetId], references: [id], onDelete: Restrict)
  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
  @@index([status, createdAt])
  @@index([assetId])
}

model FlowerAuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  targetType String?
  targetId  String?
  detail    String?  @db.Text
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([action, createdAt])
  @@index([targetId, createdAt])
  @@index([actorId, createdAt])
}

// ============ FOLLOW RECOMMENDATIONS & ENGAGEMENT SIGNALS ============

enum RecommendationEventType {
  IMPRESSION
  CLICK
  FOLLOW
  DISMISS
}

enum RecommendationBucket {
  COMMON_FOLLOW
  INTEREST
  COMMUNITY
  POPULAR
  NEW
  INTERACTION
  MIXED
}

/** 프로필 방문 이력 (본인 프로필 제외) */
model ProfileVisit {
  id            String   @id @default(cuid())
  visitorId     String
  profileUserId String
  visitCount    Int      @default(1)
  firstVisitedAt DateTime @default(now())
  lastVisitedAt DateTime @default(now())

  visitor     User @relation("ProfileVisitVisitor", fields: [visitorId], references: [id], onDelete: Cascade)
  profileUser User @relation("ProfileVisitHost", fields: [profileUserId], references: [id], onDelete: Cascade)

  @@unique([visitorId, profileUserId])
  @@index([visitorId, lastVisitedAt(sort: Desc)])
  @@index([profileUserId, lastVisitedAt(sort: Desc)])
}

/** 로그인 사용자별 게시물 조회 이력 */
model PostViewEvent {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  authorId  String
  viewCount Int      @default(1)
  firstViewedAt DateTime @default(now())
  lastViewedAt  DateTime @default(now())

  user   User @relation("PostViewViewer", fields: [userId], references: [id], onDelete: Cascade)
  author User @relation("PostViewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId, lastViewedAt(sort: Desc)])
  @@index([authorId, lastViewedAt(sort: Desc)])
  @@index([postId])
}

/** 영상(포스트 미디어 VIDEO) 시청 이력 */
model VideoWatchEvent {
  id            String   @id @default(cuid())
  userId        String
  postId        String
  authorId      String
  mediaId       String?
  watchSeconds  Int      @default(0)
  watchCount    Int      @default(1)
  firstWatchedAt DateTime @default(now())
  lastWatchedAt  DateTime @default(now())

  user   User @relation("VideoWatchViewer", fields: [userId], references: [id], onDelete: Cascade)
  author User @relation("VideoWatchAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId, lastWatchedAt(sort: Desc)])
  @@index([authorId, lastWatchedAt(sort: Desc)])
}

/** 라이브 시청 이력 */
model LiveWatchEvent {
  id            String   @id @default(cuid())
  userId        String
  channelId     String
  hostUserId    String
  watchSeconds  Int      @default(0)
  sessionCount  Int      @default(1)
  firstWatchedAt DateTime @default(now())
  lastWatchedAt  DateTime @default(now())

  user User @relation("LiveWatchViewer", fields: [userId], references: [id], onDelete: Cascade)
  host User @relation("LiveWatchHost", fields: [hostUserId], references: [id], onDelete: Cascade)

  @@unique([userId, channelId])
  @@index([userId, lastWatchedAt(sort: Desc)])
  @@index([hostUserId, lastWatchedAt(sort: Desc)])
  @@index([channelId])
}

/** 사용자 성장률 시계열 스냅샷 (일 단위) */
model UserGrowthSnapshot {
  id                 String   @id @default(cuid())
  userId             String
  /** YYYY-MM-DD UTC */
  dateKey            String
  followerCount      Int      @default(0)
  followingCount     Int      @default(0)
  postCount          Int      @default(0)
  likeReceivedCount  Int      @default(0)
  commentReceivedCount Int    @default(0)
  postViewCount      Int      @default(0)
  createdAt          DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dateKey])
  @@index([dateKey])
  @@index([userId, dateKey(sort: Desc)])
}

/** 사용자별 캐시된 팔로우 추천 결과 */
model FollowRecommendation {
  id          String               @id @default(cuid())
  userId      String
  candidateId String
  score       Float
  bucket      RecommendationBucket @default(MIXED)
  /** [{ signalId, score, label? }] */
  reasons     Json
  rank        Int
  computedAt  DateTime             @default(now())
  expiresAt   DateTime

  user      User @relation("FollowRecViewer", fields: [userId], references: [id], onDelete: Cascade)
  candidate User @relation("FollowRecCandidate", fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([userId, candidateId])
  @@index([userId, rank])
  @@index([userId, expiresAt])
  @@index([computedAt])
}

/** 추천 노출·클릭·팔로우 전환 (품질 개선용) */
model RecommendationEvent {
  id          String                   @id @default(cuid())
  userId      String
  candidateId String
  eventType   RecommendationEventType
  source      String                   @default("profile_sidebar")
  score       Float?
  bucket      RecommendationBucket?
  metadata    Json?
  createdAt   DateTime                 @default(now())

  user      User @relation("RecEventViewer", fields: [userId], references: [id], onDelete: Cascade)
  candidate User @relation("RecEventCandidate", fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([candidateId, eventType, createdAt(sort: Desc)])
  @@index([eventType, createdAt(sort: Desc)])
  @@index([source, createdAt(sort: Desc)])
}

enum FeedBucket {
  IN_NETWORK
  TRENDING
  DISCOVERY
  INTEREST
  MIXED
}

/** 사용자별 캐시된 For You 피드 랭킹 */
model FeedRecommendation {
  id         String     @id @default(cuid())
  userId     String
  postId     String
  score      Float
  bucket     FeedBucket @default(MIXED)
  inNetwork  Boolean    @default(false)
  /** { signals: [{ signalId, score, label? }], sourceId? } */
  reasons    Json
  rank       Int
  computedAt DateTime   @default(now())
  expiresAt  DateTime

  user User @relation("FeedRecViewer", fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId, rank])
  @@index([userId, expiresAt])
  @@index([computedAt])
}

enum CommerceRecommendationKind {
  STAR_MARKET
  USED_MARKET
}

/** 사용자별 마켓·중고 랭킹 캐시 */
model CommerceRecommendation {
  id         String                     @id @default(cuid())
  userId     String
  kind       CommerceRecommendationKind
  listingId  String
  score      Float
  bucket     String                     @default("MIXED")
  /** { signals: [{ signalId, score, label? }], sourceId? } */
  reasons    Json
  rank       Int
  computedAt DateTime                   @default(now())
  expiresAt  DateTime

  user User @relation("CommerceRecViewer", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, listingId])
  @@index([userId, kind, rank])
  @@index([userId, kind, expiresAt])
  @@index([computedAt])
}

/** 계좌 1원 인증 감사 로그 — PII·계좌번호 원문 미저장 */
model BankVerificationLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  bankCode  String?
  ipHash    String?
  meta      Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
}

/** 유료 영상 재생 시 발급되는 포렌식 워터마크 세션 */
enum WatermarkSessionStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

model WatermarkSession {
  id                String                 @id @default(cuid())
  /** POST_MEDIA | EPISODE — payload identifier lives in contentId either way. */
  contentKind       String                 @default("POST_MEDIA")
  contentId         String
  userId            String
  mediaId           String?
  episodeId         String?
  /** Set when access came from a one-off media purchase. */
  purchaseId        String?
  episodePurchaseId String?
  /** Set when access came from a creator subscription instead. */
  subscriptionId    String?
  opaqueWatermarkId String                 @unique
  watermarkVersion  Int
  sessionNonce      String
  createdAt         DateTime               @default(now())
  expiresAt         DateTime
  status            WatermarkSessionStatus @default(ACTIVE)
  detectionCount    Int                    @default(0)
  lastDetectedAt    DateTime?

  user            User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  purchase        PostMediaPurchase?       @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  episodePurchase CreatorEpisodePurchase?  @relation(fields: [episodePurchaseId], references: [id], onDelete: Cascade)
  media           PostMedia?               @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  episode         CreatorEpisode?          @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  logs            WatermarkDetectionLog[]

  @@index([contentId, createdAt(sort: Desc)])
  @@index([contentKind, contentId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([mediaId])
  @@index([episodeId])
  @@index([purchaseId])
  @@index([episodePurchaseId])
  @@index([subscriptionId])
  @@index([status, expiresAt])
  @@index([opaqueWatermarkId])
}

enum WatermarkDetectionJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

/** Admin forensic analysis job. Frames stay in memory for the request; only the result is stored. */
model WatermarkDetectionJob {
  id             String                      @id @default(cuid())
  status         WatermarkDetectionJobStatus @default(PENDING)
  actorId        String
  contentId      String?
  sourceKind     String
  sourceFileHash String?
  clientFileHash String?
  result         Json?
  error          String?
  createdAt      DateTime                    @default(now())
  completedAt    DateTime?

  actor User @relation("WatermarkDetectionJobAdmin", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([actorId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
}

/** 관리자 유출본 분석 결과 로그 */
model WatermarkDetectionLog {
  id                 String   @id @default(cuid())
  watermarkSessionId String?
  contentId          String?
  detectionType      String
  confidence         Float
  detectedRegions    Json?
  sourceFileHash     String
  resultStatus       String
  metadata           Json?
  actorId            String?
  createdAt          DateTime @default(now())

  session WatermarkSession? @relation(fields: [watermarkSessionId], references: [id], onDelete: SetNull)
  actor   User?             @relation("WatermarkDetectionAdmin", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([watermarkSessionId, createdAt(sort: Desc)])
  @@index([contentId, createdAt(sort: Desc)])
  @@index([sourceFileHash])
  @@index([resultStatus, createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
}
