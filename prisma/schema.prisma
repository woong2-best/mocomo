  userAgent  String?
  ip         String?
  expiresAt  DateTime
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

/** 관리자 로그인 시도 기록 */
model AdminLoginAttempt {
  id            String   @id @default(cuid())
  userId        String?
  username      String?
  email         String?
  ip            String?
  country       String?
  userAgent     String?
  browser       String?
  os            String?
  device        String?
