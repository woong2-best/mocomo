generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============ AUTH & USER ============

enum UserRole {
  USER
  VERIFIED
  MARKETING
  CUSTOMER_SUPPORT
  MODERATOR
  SETTLEMENT_MANAGER
  SENIOR_MODERATOR
  ADMIN
  SUPER_ADMIN
  OWNER
}

enum ModerationCaseStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

enum RiskScoreSource {
  SYSTEM
  REPORT
  AI
  ADMIN
  AUTO
}

enum LiveStreamCategory {
  LIVE
  JUST_CHATTING
  GAME
  MUSIC
  IRL
}

enum LiveStreamStatus {
  LIVE
  SCHEDULED
  ENDED
}

enum LiveBroadcastMode {
  BROWSER
  OBS
  VOICE
  /** 외부 플랫폼(유튜브/트위치/치지직) 임베드 — 자체 송출 없음 */
  EXTERNAL
}

enum LiveMediaSourceType {
  FIRST_PARTY
  EXTERNAL
}

enum LiveExternalProvider {
  YOUTUBE
  TWITCH
  CHZZK
}

/** 연결된 스트리밍 플랫폼 — OAuth·수동 검증 */
enum StreamingPlatform {
  YOUTUBE
  TWITCH
  CHZZK
  KICK
  AFREECA
  SOOP
  FACEBOOK
  TIKTOK
  OTHER
}

enum StreamingVerificationMethod {
  OAUTH
  PROFILE_CODE
  DESCRIPTION_CODE
  STREAM_TITLE
  MANUAL_ADMIN
}

enum LiveVisibility {
  PUBLIC
  PRIVATE
}

enum LiveSupportEventType {
  GENERAL
  TTS
  ROULETTE
  SOUND
  VOTE
}

enum LiveSupportMissionStatus {
  PENDING
  ACCEPTED
  COMPLETED
  FAILED
  CANCELLED
}

enum PremiumTier {
  FREE
  PREMIUM
}

enum FeedDisplayMode {
  TIMELINE
  COMPACT
}

enum AccountStatus {
  ACTIVE
  LIMITED
  READ_ONLY
  TEMP_SUSPENDED
  PERMANENT_SUSPENDED
  BANNED
}

enum AppealStatus {
  RECEIVED
  UNDER_REVIEW
  INFO_REQUESTED
  APPROVED
  REJECTED
  CLOSED
}

enum ContentVisibility {
  PUBLIC
  SUBSCRIBERS
  SUBSCRIBER_1M
  SUBSCRIBER_3M
  SUBSCRIBER_6M
  SUBSCRIBER_12M
}

model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  emailVerified DateTime?
  username      String    @unique
  passwordHash  String?
  name          String?
  image         String?
  role          UserRole  @default(USER)
  premiumTier   PremiumTier @default(FREE)
  premiumUntil  DateTime?
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret String?
  showNsfw      Boolean   @default(false)
  isBanned      Boolean   @default(false)
  banReason     String?
  bannedUntil   DateTime?
  accountStatus AccountStatus @default(ACTIVE)
  suspensionReason String?  @db.Text
  suspendedAt   DateTime?
  suspendedById String?
  suspensionExpiresAt DateTime?
  riskScore           Int       @default(0)
  riskScoreUpdatedAt  DateTime?
  lastRiskDecayAt     DateTime?
  moderationReviewRequired Boolean @default(false)
  moderationUrgentReview   Boolean @default(false)
  sanctionPendingApproval  Boolean @default(false)
  priorSanctionCount       Int     @default(0)
  totalSupportSent     Int              @default(0)
  supportTierSent      SupportTierLevel @default(SEED)
  totalSupportReceived Int              @default(0)
  supportTierReceived  SupportTierLevel @default(SEED)
  locale        String    @default("ko")
  countryCode   String    @default("KR")
  /** IANA Time Zone (e.g. America/New_York) — calendar / day boundaries; not derived from country alone */
  timeZone      String    @default("UTC")
  feedDisplayMode FeedDisplayMode @default(TIMELINE)
  /** 트위터 Protect와 동일 — 잠금 시 승인된 팔로워만 글 열람, 새 팔로우는 요청 */
  postsLocked   Boolean   @default(false)
  phone         String?   @unique
  phoneVerified DateTime?
  /** Apick 1원 계좌 인증 — 중고거래·판매자 정산 */
  bankVerifiedAt           DateTime?
  settlementBankCode       String?
  settlementAccountLast4   String?
  settlementAccountHolder  String?
  /** HMAC-SHA256 — 계좌번호 원문 미저장, 1계좌=1계정 */
  settlementAccountHash    String?   @unique
  /** 중고거래 청소년 보호 — 만 19세 이상 성인 인증 */
  adultVerifiedAt DateTime?
  birthDate       DateTime? @db.Date
  /** 경매 낙찰 미결제 등으로 중고거래 영구 제한 */
  usedMarketBannedAt         DateTime?
  usedMarketBanReason        String?
  usedMarketBanListingId     String?
  auctionWinCount            Int       @default(0)
  auctionPaymentDefaultCount Int       @default(0)
  auctionLastPaymentDefaultAt DateTime?
  /** 계정당 1개 — OBS 방송 키 (방송 세션마다 바뀌지 않음) */
  obsRtmpStreamKey String? @unique
  /** 크리에이터 월 구독료 (원) — Stripe Subscription 연동 전에도 UI·검증용 */
  creatorSubscriptionPriceKrw Int @default(1299)
  /** 1:1 유료 통화 예약 — 크리에이터(코스플레이/스트리머) 전용 */
  creatorCallEnabled        Boolean @default(false)
  creatorCallRateKrwPerHour Int?
  /** Stripe Connect — 정산용 (추후 onboarding) */
  stripeConnectAccountId String?
  stripeConnectOnboardedAt DateTime?
  /** Stripe Customer — 저장된 결제 카드 (지갑 탭) */
  stripeCustomerId String? @unique
  /** 회원 탈퇴 요청 시각 (50일 복구 기간) */
  deletedAt           DateTime?
  /** 영구 삭제 예정 시각 — 탈퇴 다음날부터 50일 */
  scheduledPurgeAt    DateTime?
  deletionReason      String?
  /** 최근 로그인 (세션/로그인 콜백에서 갱신) */
  lastLoginAt         DateTime?
  /** 관리자 계정 활성 여부 (스태프 역할일 때) */
  adminDisabledAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  usernameChangeLogs UsernameChangeLog[]
  calendarMemos CalendarMemo[]
  adminMemosAbout AdminUserMemo[] @relation("AdminMemoSubject")
  adminMemosWritten AdminUserMemo[] @relation("AdminMemoAuthor")
  couponsCreated    Coupon[] @relation("CouponCreator")
  couponAssignments CouponAssignment[] @relation("CouponAssignee")
