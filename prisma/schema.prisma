model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  /** Google OAuth — HMAC-SHA-256(sub) 로그인 조회용 (평문 sub 미저장) */
  googleSubHash       String?
  /** Google OAuth — HMAC-SHA-256(email) 계정 연동 조회용 */
  googleEmailHash     String?
  /** AES-256-GCM 암호문 (sub·email·name·image·tokens JSON) */
  encryptedGoogleData String? @db.Text
  encryptionIv        String?
  encryptionAuthTag   String?
  /** 암호화 키 버전 — 키 로테이션 시 복호화용 */
  encryptionKeyId     String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
  @@index([googleSubHash])
  @@index([googleEmailHash])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

model UsernameChangeLog {
  id          String   @id @default(cuid())
  userId      String
  oldUsername String
  newUsername String
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique
  bio         String?  @db.Text
  bannerUrl   String?
  /** 프로필 배너 동영상 (최대 10초, 이미지 배너와 동시 사용 안 함) */
  bannerVideoUrl String?
  snsLinks    Json?
  favoriteTags String[]
  mainCharacter String?
  nicknameEffect String?
  /** 프로필에 생일(월·일) 공개 */
  showBirthdayOnProfile Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/** 프로필 사이드바 달력 — 일자별 개인 메모 */
model CalendarMemo {
  id        String   @id @default(cuid())
  userId    String
  /** YYYY-MM-DD (로컬 캘린더 기준) */
  dateKey   String
  body      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dateKey])
  @@index([userId, dateKey])
}

model Badge {
  id          String   @id @default(cuid())
  name        String
  description String?
  imageUrl    String
  rarity      String   @default("common")
  userBadges  UserBadge[]
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  badgeId   String
  earnedAt  DateTime @default(now())
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  @@unique([userId, badgeId])
}

// ============ COMMUNITY ============

enum CommunityCategory {
  GAME
  ANIME
  COMIC
  VTUBER
  UTAITE
  VOCALOID
  FANART
  AI
  COSPLAY
  GOODS
  FIGURE
}

model Community {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?  @db.Text
  iconUrl     String?
  bannerUrl   String?
  bannerVideoUrl String?
  coverUrl    String?
  category    CommunityCategory
  isNsfw      Boolean  @default(false)
  parentId    String?
  parent      Community?  @relation("SubCommunity", fields: [parentId], references: [id])
  children    Community[] @relation("SubCommunity")
  creatorId   String
  memberCount Int      @default(0)
  joinMode    CommunityJoinMode @default(OPEN)
  isPublic    Boolean  @default(true)
