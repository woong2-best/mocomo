generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============ AUTH & USER ============

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

enum LiveStreamCategory {
  LIVE
  JUST_CHATTING
  GAME
  MUSIC
  IRL
}

enum LiveStreamStatus {
  LIVE
  SCHEDULED
  ENDED
}

enum LiveBroadcastMode {
  BROWSER
  OBS
  VOICE
}

enum LiveVisibility {
  PUBLIC
  PRIVATE
}

enum LiveSupportEventType {
  GENERAL
  TTS
  ROULETTE
  SOUND
  VOTE
}

enum LiveSupportMissionStatus {
  PENDING
  ACCEPTED
  COMPLETED
  FAILED
  CANCELLED
}

enum PremiumTier {
  FREE
  PREMIUM
}

enum FeedDisplayMode {
  TIMELINE
  COMPACT
}

enum AccountStatus {
  ACTIVE
  LIMITED
  READ_ONLY
  TEMP_SUSPENDED
  PERMANENT_SUSPENDED
  BANNED
}

enum AppealStatus {
  RECEIVED
  UNDER_REVIEW
  INFO_REQUESTED
  APPROVED
  REJECTED
  CLOSED
}

enum ContentVisibility {
  PUBLIC
  SUBSCRIBERS
  SUBSCRIBER_1M
  SUBSCRIBER_3M
  SUBSCRIBER_6M
  SUBSCRIBER_12M
}

model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  emailVerified DateTime?
  username      String    @unique
  passwordHash  String?
  name          String?
  image         String?
  role          UserRole  @default(USER)
  premiumTier   PremiumTier @default(FREE)
  premiumUntil  DateTime?
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret String?
  showNsfw      Boolean   @default(false)
  isBanned      Boolean   @default(false)
  banReason     String?
  bannedUntil   DateTime?
  accountStatus AccountStatus @default(ACTIVE)
  suspensionReason String?  @db.Text
  suspendedAt   DateTime?
  suspendedById String?
  suspensionExpiresAt DateTime?
  level         Int       @default(1)
  xp            Int       @default(0)
  totalSupportSent     Int              @default(0)
  supportTierSent      SupportTierLevel @default(PEBBLE)
  totalSupportReceived Int              @default(0)
  supportTierReceived  SupportTierLevel @default(PEBBLE)
  locale        String    @default("ko")
  countryCode   String    @default("KR")
  feedDisplayMode FeedDisplayMode @default(TIMELINE)
  phone         String?   @unique
  phoneVerified DateTime?
  /** 중고거래 청소년 보호 — 만 19세 이상 성인 인증 */
  adultVerifiedAt DateTime?
  birthDate       DateTime? @db.Date
  /** 경매 낙찰 미결제 등으로 중고거래 영구 제한 */
  usedMarketBannedAt         DateTime?
  usedMarketBanReason        String?
  usedMarketBanListingId     String?
  auctionWinCount            Int       @default(0)
  auctionPaymentDefaultCount Int       @default(0)
  auctionLastPaymentDefaultAt DateTime?
  /** 계정당 1개 — OBS 방송 키 (방송 세션마다 바뀌지 않음) */
  obsRtmpStreamKey String? @unique
  /** 크리에이터 월 구독료 (원) — Stripe Subscription 연동 전에도 UI·검증용 */
  creatorSubscriptionPriceKrw Int @default(16900)
  /** Stripe Connect — 정산용 (추후 onboarding) */
  stripeConnectAccountId String?
  stripeConnectOnboardedAt DateTime?
  /** 회원 탈퇴 요청 시각 (50일 복구 기간) */
  deletedAt           DateTime?
  /** 영구 삭제 예정 시각 — 탈퇴 다음날부터 50일 */
  scheduledPurgeAt    DateTime?
  deletionReason      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  usernameChangeLogs UsernameChangeLog[]
  profile       Profile?
  cosplayerProfile CosplayerProfile?
  streamerProfile  StreamerProfile?

  posts         Post[]
  comments      Comment[]
  votes         Vote[]
  bookmarks     Bookmark[]
  reports       Report[]  @relation("Reporter")
  reportsAgainst Report[] @relation("ReportedUser")
  notificationsActed Notification[] @relation("NotificationActor")

  followers     Follow[]  @relation("Following")
  following     Follow[]  @relation("Follower")
  likes         Like[]
  reposts       Repost[]

  chatMembers   ChatMember[]
  chatRoomsCreated ChatRoom[] @relation("ChatRoomsCreated")
  messages      Message[]
  messageReads  MessageRead[]
  chatPollsCreated ChatPoll[]
  chatPollVotes    ChatPollVote[]
  postPollVotes    PostPollVote[]

  voiceMembers  VoiceMember[]
  liveChatMessages LiveChatMessage[]
  streamClips       StreamClip[]
  streamClipLikes   StreamClipLike[]
  streamClipComments StreamClipComment[]
  callsMade     VoiceCall[] @relation("CallsMade")
  callsReceived VoiceCall[] @relation("CallsReceived")
  tipsSent      Tip[]     @relation("TipSender")
  tipsReceived  Tip[]     @relation("TipReceiver")
  subscriptions Subscription[] @relation("Subscriber")
  subscriptionsTo Subscription[] @relation("Creator")
  digitalProducts DigitalProduct[]
  orders        Order[]
  paymentIntents PaymentIntent[]
  userEmoticons UserEmoticon[]
  emoticonGiftsSent EmoticonGift[] @relation("EmoticonGiftSender")
  emoticonGiftsReceived EmoticonGift[] @relation("EmoticonGiftReceiver")
  goodsListingRequests GoodsListingRequest[]
  physicalProducts PhysicalProduct[]
  physicalOrdersBought PhysicalOrder[] @relation("PhysicalOrderBuyer")
  physicalOrdersSold PhysicalOrder[] @relation("PhysicalOrderSeller")
  usedListings     UsedListing[]
  usedFavorites    UsedFavorite[]
  usedListingChats UsedListingChat[] @relation("UsedListingChatBuyer")
  usedAuctionBids  UsedAuctionBid[]
  usedAuctionWins  UsedListing[]     @relation("UsedAuctionWinner")
  usedAuctionWinningBids UsedListing[] @relation("UsedAuctionWinningBidder")
  usedAuctionNegotiations UsedListing[] @relation("UsedAuctionNegotiationBuyer")
  usedPriceOffers  UsedPriceOffer[]
  cosplayBoardPosts CosplayBoardPost[]
  cosplayBoardComments CosplayBoardComment[]
  userBadges    UserBadge[]
  notifications Notification[]
  events        EventParticipant[]
  eventsCreated Event[] @relation("EventCreator")
  otakuProfile  OtakuProfile?
  fanPosts      FanPost[] @relation("FanPostCreator")
  adImpressions AdImpression[]
  modLogs       ModLog[]  @relation("ModActor")
  modLogsTarget ModLog[]  @relation("ModTarget")
  siteAdminAuditLogs SiteAdminAuditLog[] @relation("SiteAdminAuditActor")
  creatorSupportsGiven CreatorSupport[] @relation("Supporter")
  creatorSupportsReceived CreatorSupport[] @relation("Creator")
  animeFollows  AnimeFollow[]
  animesCreated Anime[] @relation("AnimeCreator")
  animeRevisions AnimeRevision[] @relation("AnimeRevisionEditor")
  animeDeleteRequests AnimeDeleteRequest[]
  suspensionsIssued   AccountSuspensionLog[] @relation("SuspensionActor")
  suspensionLogs      AccountSuspensionLog[] @relation("SuspensionTarget")
  accountAppeals      AccountAppeal[]
  appealsAdministered AccountAppeal[] @relation("AppealAdmin")
  banEvasionAsNew     BanEvasionSuspect[] @relation("BanEvasionNew")
  banEvasionAsLinked  BanEvasionSuspect[] @relation("BanEvasionLinked")

  pushSubscriptions PushSubscription[]
  mobilePushTokens  MobilePushToken[]
  avatarPresets     AvatarPreset[]
  aptProfile        AptProfile?
  aptDioramaLayouts AptDioramaLayout[]
  aptPresence       AptPresence?
  aptVisitsHosted   AptHomeVisit[] @relation("AptVisitHost")
  aptVisitsMade     AptHomeVisit[] @relation("AptVisitVisitor")
  aptHomeLikesGiven AptHomeLike[]  @relation("AptHomeLiker")
  aptHomeLikesRecv  AptHomeLike[]  @relation("AptHomeLikeHost")
  aptFavoriteHomes  AptFavoriteHome[] @relation("AptFavoriteOwner")
  aptFavoritedBy    AptFavoriteHome[] @relation("AptFavoriteHost")
  aptCohabHosted     AptCohabitant[] @relation("AptCohabHost")
  aptCohabResidences AptCohabitant[] @relation("AptCohabResident")
  aptCohabRequestsSent AptCohabitationRequest[] @relation("AptCohabRequestRequester")
  aptCohabRequestsReceived AptCohabitationRequest[] @relation("AptCohabRequestHost")
  aptMarketListings AptMarketListing[]
  aptWallet           AptWallet?
  aptInventoryItems   AptInventoryItem[]
  aptStorageItems     AptStorageItem[]
  aptWalletTransactions AptWalletTransaction[]
  aptIapPurchases     AptIapPurchase[]
  aptMarketBought     AptMarketListing[] @relation("AptMarketBuyer")
  aptEconomyOperations AptEconomyOperation[]
  aptEconomyLogs      AptEconomyLog[]
  aptEconomyConfigChanges AptEconomyConfigChangeLog[] @relation("AptEconomyConfigChanges")
  aptEconomyConfigPublished AptEconomyConfig[] @relation("AptEconomyConfigPublisher")
  aptGoldShopOfferChanges AptGoldShopOfferChangeLog[] @relation("AptGoldShopOfferChanges")
  aptFleaEventChanges     AptFleaEventChangeLog[]     @relation("AptFleaEventChanges")
  aptFraudProfile         AptFraudProfile?
  aptFraudEvents          AptFraudEvent[]
  aptFraudActions         AptFraudAction[]            @relation("AptFraudActionUser")
  aptFraudActionsTaken    AptFraudAction[]            @relation("AptFraudActionAdmin")
  aptFraudScoreHistory    AptFraudScoreHistory[]
  aptUserDevices          AptUserDevice[]
  aptFraudRuleChanges     AptFraudRuleChangeLog[] @relation("AptFraudRuleChanges")
  aptFraudRulePublished   AptFraudRuleMeta[]      @relation("AptFraudRulePublisher")
  aptCsMemosWritten       AptCsMemo[]             @relation("AptCsMemoAdmin")
  aptCsMemos              AptCsMemo[]             @relation("AptCsMemoUser")
  aptMarketAdminLogs      AptMarketAdminLog[]     @relation("AptMarketAdminLogs")
  aptMarketAdminUpdated   AptMarketAdminMeta[]    @relation("AptMarketAdminUpdater")
  aptNotifications        AptNotification[]
  aptEconomyFeatureFlagUpdates AptEconomyFeatureFlag[] @relation("AptEconomyFeatureFlagUpdater")
  aptEconomyFeatureFlagLogs    AptEconomyFeatureFlagLog[] @relation("AptEconomyFeatureFlagLogs")
  aptEconomySnapshotsCreated   AptEconomySnapshot[]       @relation("AptEconomySnapshotCreator")
  aptEconomyRestores           AptEconomyRestoreLog[]     @relation("AptEconomyRestoreAdmin")
  aptEconomyCanariesCreated    AptEconomyCanary[]         @relation("AptEconomyCanaryCreator")
  aptEconomyCanaryLogs         AptEconomyCanaryLog[]      @relation("AptEconomyCanaryAdmin")
  aptEconomyHealthRulesUpdated AptEconomyHealthRule[]   @relation("AptEconomyHealthRuleUpdater")
  aptEconomyHealthAlertsResolved AptEconomyHealthAlert[] @relation("AptEconomyHealthAlertResolver")

  creatorSeries            CreatorSeries[]          @relation("CreatorSeriesAuthor")
  creatorEpisodes          CreatorEpisode[]         @relation("CreatorEpisodeAuthor")
  creatorEpisodePurchases  CreatorEpisodePurchase[]
  postMediaPurchases       PostMediaPurchase[]
  webtoonStudioProjects    WebtoonStudioProject[]
  webtoonStudioSettings    WebtoonStudioSettings?

  wallet           Wallet?
  bankAccount      BankAccount?
  payoutRequests   PayoutRequest[]
  ledgerEntries    LedgerEntry[]
  payoutsProcessed PayoutRequest[] @relation("PayoutProcessor")

  liveSupportSent              LiveSupportEvent[]     @relation("LiveSupportSender")
  liveSupportReceived          LiveSupportEvent[]     @relation("LiveSupportReceiver")
  liveSupportMissionsSent      LiveSupportMission[]   @relation("LiveMissionSender")
  liveSupportMissionsReceived  LiveSupportMission[]   @relation("LiveMissionReceiver")
  liveSupportPollsHosted       LiveSupportPoll[]      @relation("LivePollHost")
  liveSupportPollVotes         LiveSupportPollVote[]
  liveVideoDonationsSent       LiveVideoDonation[]    @relation("LiveVideoDonationSender")
  liveVideoDonationsReceived   LiveVideoDonation[]    @relation("LiveVideoDonationReceiver")

  discoveryProfile        DiscoveryProfile?
  discoverySwipesSent     DiscoverySwipe[] @relation("DiscoverySwipeFrom")
  discoverySwipesReceived DiscoverySwipe[] @relation("DiscoverySwipeTo")
  discoveryMatchesAsA     DiscoveryMatch[] @relation("DiscoveryMatchA")
  discoveryMatchesAsB     DiscoveryMatch[] @relation("DiscoveryMatchB")
  discoveryBlocks         DiscoveryBlock[] @relation("DiscoveryBlocker")
  discoveryBlockedBy      DiscoveryBlock[] @relation("DiscoveryBlocked")
  userBlocks              UserBlock[]      @relation("UserBlocker")
  userBlockedBy           UserBlock[]      @relation("UserBlocked")
  userMutes               UserMute[]       @relation("UserMuter")
  userMutedBy             UserMute[]       @relation("UserMuted")

  studioCreatorProfile    StudioCreatorProfile?
  studioAssets            StudioAsset[]
  studioFollows           StudioCreatorFollow[] @relation("StudioFollower")
  studioFollowers         StudioCreatorFollow[] @relation("StudioFollowing")
  studioAssetLikes        StudioAssetLike[]
  studioAssetPurchases    StudioAssetPurchase[]
  studioWallet            StudioWallet?
  studioPayoutRequests    StudioPayoutRequest[]
  studioBankAccount       StudioBankAccount?
  studioUserInventory     StudioUserInventory[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  /** Google OAuth — HMAC-SHA-256(sub) 로그인 조회용 (평문 sub 미저장) */
  googleSubHash       String?
  /** Google OAuth — HMAC-SHA-256(email) 계정 연동 조회용 */
  googleEmailHash     String?
  /** AES-256-GCM 암호문 (sub·email·name·image·tokens JSON) */
  encryptedGoogleData String? @db.Text
  encryptionIv        String?
  encryptionAuthTag   String?
  /** 암호화 키 버전 — 키 로테이션 시 복호화용 */
  encryptionKeyId     String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
  @@index([googleSubHash])
  @@index([googleEmailHash])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

model UsernameChangeLog {
  id          String   @id @default(cuid())
  userId      String
  oldUsername String
  newUsername String
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique
  bio         String?  @db.Text
  bannerUrl   String?
  snsLinks    Json?
  favoriteTags String[]
  mainCharacter String?
  nicknameEffect String?
  /** 프로필에 생일(월·일) 공개 */
  showBirthdayOnProfile Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Badge {
  id          String   @id @default(cuid())
  name        String
  description String?
  imageUrl    String
  rarity      String   @default("common")
  userBadges  UserBadge[]
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  badgeId   String
  earnedAt  DateTime @default(now())
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  @@unique([userId, badgeId])
}

// ============ COMMUNITY ============

enum CommunityCategory {
  ANIME
  MANGA
  GAME
  VTUBER
  COSPLAY
  FIGURE
  ART
  MUSIC
  AI_ART
  LIGHT_NOVEL
  GOODS
  NSFW
  OTHER
}

model Community {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?  @db.Text
  iconUrl     String?
  bannerUrl   String?
  category    CommunityCategory
  isNsfw      Boolean  @default(false)
  parentId    String?
  parent      Community?  @relation("SubCommunity", fields: [parentId], references: [id])
  children    Community[] @relation("SubCommunity")
  creatorId   String
  memberCount Int      @default(0)
  joinMode    CommunityJoinMode @default(OPEN)
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  posts       Post[]
  members     CommunityMember[]
  chatRooms   ChatRoom[]
  channelCategories CommunityChannelCategory[]
  channels    CommunityChannel[]
  roles       CommunityRole[]
  voiceChannels VoiceChannel[]
  invites     CommunityInvite[]
  joinRequests CommunityJoinRequest[]
  bans        CommunityBan[]
  auditLogs   CommunityAuditLog[]
  events      Event[]
}

enum CommunityJoinMode {
  OPEN
  APPROVE
  INVITE_ONLY
}

enum CommunityJoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CommunityChannelType {
  POSTS
  TEXT
  VOICE
  VIDEO
  LIVE
  ANNOUNCEMENT
  EVENT
  QA
  GALLERY
  FILE
  MEMBERS
  SETTINGS
}

enum CommunityPresenceStatus {
  ONLINE
  IDLE
  DND
  OFFLINE
}

enum CommunityRoleType {
  OWNER
  ADMIN
  MODERATOR
  VIP
  MEMBER
}

model CommunityChannelCategory {
  id          String   @id @default(cuid())
  communityId String
  name        String
  position    Int      @default(0)
  createdAt   DateTime @default(now())

  community Community          @relation(fields: [communityId], references: [id], onDelete: Cascade)
  channels  CommunityChannel[]

  @@index([communityId, position])
}

model CommunityChannel {
  id             String               @id @default(cuid())
  communityId    String
  categoryId     String?
  type           CommunityChannelType
  name           String
  slug           String
  topic          String?              @db.VarChar(500)
  position       Int                  @default(0)
  isDefault      Boolean              @default(false)
  chatRoomId     String?              @unique
  voiceChannelId String?              @unique
  maxUsers       Int?
  slowModeSec    Int                  @default(0)
  isLocked       Boolean              @default(false)
  vipOnly        Boolean              @default(false)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  community    Community                 @relation(fields: [communityId], references: [id], onDelete: Cascade)
  category     CommunityChannelCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  chatRoom     ChatRoom?                 @relation(fields: [chatRoomId], references: [id], onDelete: SetNull)
  voiceChannel VoiceChannel?             @relation(fields: [voiceChannelId], references: [id], onDelete: SetNull)
  reads        CommunityChannelRead[]

  @@unique([communityId, slug])
  @@index([communityId, position])
  @@index([communityId, type])
}

model CommunityRole {
  id          String            @id @default(cuid())
  communityId String
  name        String
  type        CommunityRoleType @default(MEMBER)
  color       String?           @db.VarChar(7)
  position    Int               @default(0)
  permissions Json              @default("{}")
  isDefault   Boolean           @default(false)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  community Community             @relation(fields: [communityId], references: [id], onDelete: Cascade)
  members   CommunityMemberRole[]

  @@unique([communityId, name])
  @@index([communityId, position])
}

model CommunityMemberRole {
  id       String @id @default(cuid())
  memberId String
  roleId   String

  member CommunityMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  role   CommunityRole   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([memberId, roleId])
}

model CommunityChannelRead {
  id            String   @id @default(cuid())
  channelId     String
  userId        String
  lastReadAt    DateTime @default(now())
  lastMessageId String?

  channel CommunityChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([userId])
}

model CommunityMember {
  id            String                   @id @default(cuid())
  communityId   String
  userId        String
  role          String                   @default("member")
  nickname      String?
  presence      CommunityPresenceStatus  @default(OFFLINE)
  voiceActivity CommunityVoiceActivity?
  lastSeenAt    DateTime?
  welcomedAt    DateTime?
  joinedAt      DateTime                 @default(now())
  community     Community                @relation(fields: [communityId], references: [id], onDelete: Cascade)
  memberRoles   CommunityMemberRole[]
  @@unique([communityId, userId])
  @@index([communityId, presence])
  @@index([communityId, joinedAt])
}

enum CommunityVoiceActivity {
  VOICE
  VIDEO
}

model CommunityInvite {
  id          String    @id @default(cuid())
  communityId String
  code        String    @unique
  createdById String
  maxUses     Int?
  useCount    Int       @default(0)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  @@index([communityId])
}

model CommunityJoinRequest {
  id          String                     @id @default(cuid())
  communityId String
  userId      String
  status      CommunityJoinRequestStatus @default(PENDING)
  message     String?                    @db.VarChar(500)
  createdAt   DateTime                   @default(now())
  reviewedAt  DateTime?
  community   Community                  @relation(fields: [communityId], references: [id], onDelete: Cascade)
  @@unique([communityId, userId])
  @@index([communityId, status])
}

model CommunityBan {
  id          String    @id @default(cuid())
  communityId String
  userId      String
  reason      String?   @db.VarChar(500)
  bannedById  String
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  @@unique([communityId, userId])
}

model CommunityAuditLog {
  id          String   @id @default(cuid())
  communityId String
  actorId     String
  action      String
  targetType  String?
  targetId    String?
  detail      String?  @db.VarChar(500)
  createdAt   DateTime @default(now())
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  @@index([communityId, createdAt(sort: Desc)])
}

enum PostType {
  GENERAL
  PHOTO
  VIDEO
  COSPLAY
  FANART
  REVIEW
  MEME
  NEWS
}

enum SupportTierLevel {
  PEBBLE
  STONE
  COAL
  IRON
  BRONZE
  SILVER
  GOLD
  PLATINUM
  EMERALD
  SAPPHIRE
  RUBY
  DIAMOND
  CRYSTAL
  MYTHRIL
  ORICHALCUM
  CELESTITE
  ASTRAL
  COSMIC
  ETERNAL
}

model Post {
  id          String   @id @default(cuid())
  title       String?
  content     String   @db.Text
  authorId    String
  communityId String?
  animeId     String?
  postType    PostType @default(GENERAL)
  isNsfw      Boolean  @default(false)
  viewCount   Int      @default(0)
  shareCount  Int      @default(0)
  hotScore    Float    @default(0)
  isPinned    Boolean  @default(false)
  visibility  ContentVisibility @default(PUBLIC)
  /** 구독 등급 미달 시 즉시 구매로 열람 (원, 0=비활성) */
  instantPurchasePriceKrw Int @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  community Community? @relation(fields: [communityId], references: [id], onDelete: SetNull)
  anime     Anime?    @relation(fields: [animeId], references: [id], onDelete: SetNull)
  media     PostMedia[]
  tags      PostTag[]
  comments  Comment[]
  votes     Vote[]
  bookmarks Bookmark[]
  reports   Report[]
  likes     Like[]
  reposts   Repost[]
  poll      PostPoll?

  @@index([createdAt(sort: Desc)])
  @@index([hotScore(sort: Desc), createdAt(sort: Desc)])
  @@index([authorId, createdAt(sort: Desc)])
  @@index([authorId, isPinned])
  @@index([communityId, createdAt(sort: Desc)])
}

enum MediaType {
  IMAGE
  VIDEO
  GIF
  AUDIO
}

model PostMedia {
  id             String    @id @default(cuid())
  postId         String
  url            String
  type           MediaType
  width          Int?
  height         Int?
  duration       Int?
  order          Int       @default(0)
  priceKrw       Int       @default(0)
  purchaseCount  Int       @default(0)
  post           Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  purchases      PostMediaPurchase[]

  @@index([postId, order])
}

model PostMediaPurchase {
  id        String   @id @default(cuid())
  buyerId   String
  mediaId   String
  price     Int
  createdAt DateTime @default(now())

  buyer User      @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  media PostMedia @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([buyerId, mediaId])
  @@index([buyerId, createdAt(sort: Desc)])
  @@index([mediaId])
}

model Tag {
  id       String   @id @default(cuid())
  name     String   @unique
  slug     String   @unique
  parentId String?
  parent   Tag?     @relation("TagTree", fields: [parentId], references: [id])
  children Tag[]    @relation("TagTree")
  postTags PostTag[]
}

model PostTag {
  postId String
  tagId  String
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)
  @@id([postId, tagId])
}

model Comment {
  id        String   @id @default(cuid())
  content   String   @db.Text
  authorId  String
  postId    String
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author   User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  post     Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  parent   Comment? @relation("CommentReplies", fields: [parentId], references: [id])
  replies  Comment[] @relation("CommentReplies")
  reports  Report[]

  @@index([postId, parentId, createdAt])
  @@index([authorId, createdAt(sort: Desc)])
}

enum VoteType {
  UP
  DOWN
}

model Vote {
  id     String   @id @default(cuid())
  userId String
  postId String
  type   VoteType
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  @@unique([userId, postId])
}

model PostPoll {
  id        String   @id @default(cuid())
  postId    String   @unique
  closesAt  DateTime
  closed    Boolean  @default(false)
  createdAt DateTime @default(now())

  post    Post             @relation(fields: [postId], references: [id], onDelete: Cascade)
  options PostPollOption[]
  votes   PostPollVote[]
}

model PostPollOption {
  id     String @id @default(cuid())
  pollId String
  label  String
  order  Int    @default(0)

  poll  PostPoll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes PostPollVote[]
}

model PostPollVote {
  id       String   @id @default(cuid())
  pollId   String
  optionId String
  userId   String
  votedAt  DateTime @default(now())

  poll   PostPoll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option PostPollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId])
}

model Bookmark {
  id     String   @id @default(cuid())
  userId String
  postId String
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  @@unique([userId, postId])
}

// ============ SNS ============

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower  User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)
  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId, createdAt(sort: Desc)])
}

model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("UserBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("UserBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

model UserMute {
  id        String   @id @default(cuid())
  muterId   String
  mutedId   String
  createdAt DateTime @default(now())

  muter User @relation("UserMuter", fields: [muterId], references: [id], onDelete: Cascade)
  muted User @relation("UserMuted", fields: [mutedId], references: [id], onDelete: Cascade)

  @@unique([muterId, mutedId])
  @@index([muterId])
}

model Like {
  id     String   @id @default(cuid())
  userId String
  postId String
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  @@unique([userId, postId])
  @@index([userId, createdAt(sort: Desc)])
}

model Repost {
  id     String   @id @default(cuid())
  userId String
  postId String
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  @@unique([userId, postId])
}

model TrendingSnapshot {
  id        String   @id @default(cuid())
  type      String
  entityId  String
  score     Float
  rank      Int
  createdAt DateTime @default(now())
}

// ============ CHAT ============

enum ChatRoomType {
  PUBLIC
  FANDOM
  DM
  GROUP
  COSPLAYER_GROUP
  SOCIAL_GROUP
}

model ChatRoom {
  id          String   @id @default(cuid())
  name        String?
  type        ChatRoomType
  communityId String?
  isPublic    Boolean  @default(true)
  createdById String?
  joinCode    String?  @unique
  joinPasswordHash String?
  requirePassword  Boolean @default(false)
  voiceChannelId   String? @unique
  announcementTitle String?
  announcementBody  String? @db.Text
  announcementById  String?
  announcementAt    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  community Community? @relation(fields: [communityId], references: [id], onDelete: SetNull)
  createdBy User?      @relation("ChatRoomsCreated", fields: [createdById], references: [id], onDelete: SetNull)
  members   ChatMember[]
  messages  Message[]
  pinned    PinnedMessage[]
  voiceCalls VoiceCall[]
  voiceChannel VoiceChannel? @relation(fields: [voiceChannelId], references: [id], onDelete: SetNull)
  polls     ChatPoll[]
  communityChannel CommunityChannel?
}

model ChatPoll {
  id        String   @id @default(cuid())
  roomId    String
  question  String
  createdBy String
  closesAt  DateTime?
  closed    Boolean  @default(false)
  createdAt DateTime @default(now())

  room    ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  creator User     @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  options ChatPollOption[]
  votes   ChatPollVote[]
}

model ChatPollOption {
  id     String @id @default(cuid())
  pollId String
  label  String
  order  Int    @default(0)

  poll  ChatPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes ChatPollVote[]
}

model ChatPollVote {
  id       String   @id @default(cuid())
  pollId   String
  optionId String
  userId   String
  votedAt  DateTime @default(now())

  poll   ChatPoll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option ChatPollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId])
}

model ChatMember {
  id       String   @id @default(cuid())
  roomId   String
  userId   String
  role     String   @default("member")
  joinedAt DateTime @default(now())
  lastReadAt DateTime?
  room ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([roomId, userId])
  @@index([userId])
}

enum MessageAttachmentType {
  IMAGE
  VIDEO
  AUDIO
  GIF
  STICKER
  FILE
}

model Message {
  id        String   @id @default(cuid())
  roomId    String
  senderId  String
  content   String?  @db.Text
  replyToId String?
  mentions  String[]
  createdAt DateTime @default(now())
  editedAt  DateTime?

  room      ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  replyTo   Message? @relation("MessageReplies", fields: [replyToId], references: [id])
  replies   Message[] @relation("MessageReplies")
  attachments MessageAttachment[]
  reads     MessageRead[]
  pinned    PinnedMessage?

  @@index([roomId, createdAt])
}

model MessageAttachment {
  id        String   @id @default(cuid())
  messageId String
  url       String
  type      MessageAttachmentType
  name      String?
  size      Int?
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
}

model MessageRead {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  readAt    DateTime @default(now())
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([messageId, userId])
}

model PinnedMessage {
  id        String   @id @default(cuid())
  roomId    String
  messageId String   @unique
  pinnedBy  String
  pinnedAt  DateTime @default(now())
  room    ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  message Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
}

// ============ VOICE ============

model StreamerProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  isPartner    Boolean  @default(false)
  bio          String?  @db.VarChar(500)
  announcement String?  @db.VarChar(500)
  scheduleNote String?  @db.VarChar(300)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VoiceChannel {
  id               String   @id @default(cuid())
  name             String
  communityId      String?
  maxUsers         Int      @default(50)
  isLive           Boolean  @default(false)
  allowScreen      Boolean  @default(true)
  allowCamera      Boolean  @default(true)
  joinPasswordHash String?
  createdBy        String
  createdAt        DateTime @default(now())
  category         LiveStreamCategory @default(JUST_CHATTING)
  tags             String[] @default([])
  thumbnailUrl     String?
  description      String?  @db.VarChar(500)
  scheduledAt      DateTime?
  liveStatus       LiveStreamStatus @default(LIVE)
  slowModeSeconds  Int      @default(0)
  chatBannedWords  String[] @default([])
  donationGoalKrw  Int?
  /** 영상 후원 — 초당 과금(원), 최소금액, 최대 재생초 */
  videoDonationRateKrw Int @default(100)
  videoDonationMinKrw  Int @default(5000)
  videoDonationMaxSec  Int @default(120)
  vodUrl           String?
  egressId         String?
  broadcastMode    LiveBroadcastMode @default(BROWSER)
  liveVisibility   LiveVisibility    @default(PUBLIC)
  minViewerTier    SupportTierLevel?
  rtmpIngressId    String?
  rtmpUrl          String?
  rtmpStreamKey    String?
  /** WHIP 송출 중인 브라우저 탭 ID — 한 탭만 송출 */
  livePublisherTabId String? @db.VarChar(64)
  endedAt          DateTime?
  /** 방송 오버레이(텍스트·돌림판·추첨) — 시청자 동기화 */
  liveOverlayJson  Json?
  /** 분할 합방 — 좌: 호스트 / 우: CO_HOST */
  liveCollabSplitEnabled Boolean @default(false)
  liveCollabUserId       String?

  community      Community?       @relation(fields: [communityId], references: [id], onDelete: SetNull)
  linkedChatRoom ChatRoom?
  communityChannel CommunityChannel?
  members        VoiceMember[]
  chatMessages   LiveChatMessage[]
  clips          StreamClip[]
  liveSupportEvents   LiveSupportEvent[]
  liveSupportMissions LiveSupportMission[]
  liveSupportPolls    LiveSupportPoll[]
  liveVideoDonations  LiveVideoDonation[]

  @@index([isLive, liveStatus, createdAt(sort: Desc)])
  @@index([isLive, liveStatus, category, createdAt(sort: Desc)])
  @@index([liveStatus, scheduledAt])
  @@index([createdBy, isLive, liveStatus])
}

model StreamClip {
  id           String   @id @default(cuid())
  channelId    String?
  authorId     String
  title        String
  videoUrl     String
  thumbnailUrl String?
  durationSec  Int      @default(0)
  isVertical   Boolean  @default(false)
  viewCount    Int      @default(0)
  likeCount    Int      @default(0)
  createdAt    DateTime @default(now())

  channel  VoiceChannel?      @relation(fields: [channelId], references: [id], onDelete: SetNull)
  author   User                 @relation(fields: [authorId], references: [id], onDelete: Cascade)
  likes    StreamClipLike[]
  comments StreamClipComment[]

  @@index([createdAt])
  @@index([likeCount])
}

model StreamClipLike {
  id        String   @id @default(cuid())
  clipId    String
  userId    String
  createdAt DateTime @default(now())

  clip StreamClip @relation(fields: [clipId], references: [id], onDelete: Cascade)
  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clipId, userId])
}

model StreamClipComment {
  id        String   @id @default(cuid())
  clipId    String
  userId    String
  content   String   @db.VarChar(500)
  createdAt DateTime @default(now())

  clip StreamClip @relation(fields: [clipId], references: [id], onDelete: Cascade)
  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clipId, createdAt])
}

model LiveChatMessage {
  id        String   @id @default(cuid())
  channelId String
  userId    String
  content   String   @db.VarChar(200)
  createdAt DateTime @default(now())

  channel VoiceChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([channelId, createdAt])
  @@index([channelId, userId, createdAt(sort: Desc)])
}

model VoiceMember {
  id         String   @id @default(cuid())
  channelId  String
  userId     String
  role       String   @default("VIEWER")
  isMuted    Boolean  @default(false)
  isDeafened Boolean  @default(false)
  cameraOn   Boolean  @default(false)
  screenOn   Boolean  @default(false)
  joinedAt   DateTime @default(now())
  lastSeenAt DateTime @default(now())
  channel VoiceChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([channelId, userId])
  @@index([channelId, lastSeenAt(sort: Desc)])
  @@index([lastSeenAt(sort: Desc)])
}

enum CallStatus {
  RINGING
  ACTIVE
  ENDED
  DECLINED
  MISSED
  CANCELLED
}

enum CallType {
  AUDIO
  VIDEO
}

model VoiceCall {
  id          String     @id @default(cuid())
  callerId    String
  calleeId    String
  chatRoomId  String?
  livekitRoom String     @unique
  callType    CallType   @default(AUDIO)
  status      CallStatus @default(RINGING)
  startedAt   DateTime?
  endedAt     DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  caller   User      @relation("CallsMade", fields: [callerId], references: [id], onDelete: Cascade)
  callee   User      @relation("CallsReceived", fields: [calleeId], references: [id], onDelete: Cascade)
  chatRoom ChatRoom? @relation(fields: [chatRoomId], references: [id], onDelete: SetNull)

  @@index([callerId, status])
  @@index([calleeId, status])
}

// ============ COSPLAYER ============

model CosplayerProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  stageName   String?
  bio         String?  @db.Text
  totalTips   Int      @default(0)
  followerCount Int    @default(0)
  minChatTier SupportTierLevel @default(STONE)
  dmEnabled   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)
  photos     CosplayPhoto[]
  schedules  CosplaySchedule[]
  fanPosts   FanPost[]
  animeLinks CosplayerAnime[]
}

model CosplayPhoto {
  id         String   @id @default(cuid())
  profileId  String
  url        String
  caption    String?
  character  String?
  series     String?
  createdAt  DateTime @default(now())
  profile CosplayerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model CosplaySchedule {
  id         String   @id @default(cuid())
  profileId  String
  title      String
  location   String?
  startsAt   DateTime
  endsAt     DateTime?
  type       String
  profile CosplayerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model FanPost {
  id         String   @id @default(cuid())
  profileId  String
  creatorId  String
  title      String
  content    String   @db.Text
  minTipAmount Int    @default(0)
  isSubscriberOnly Boolean @default(false)
  createdAt  DateTime @default(now())
  profile CosplayerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  creator User @relation("FanPostCreator", fields: [creatorId], references: [id], onDelete: Cascade)
}

// ============ MONETIZATION ============

model Tip {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  amount     Int
  message    String?
  platformFee Int
  channelId  String?
  createdAt  DateTime @default(now())
  sender   User @relation("TipSender", fields: [senderId], references: [id])
  receiver User @relation("TipReceiver", fields: [receiverId], references: [id])
  videoDonation LiveVideoDonation?

  @@index([receiverId, createdAt(sort: Desc)])
  @@index([receiverId, senderId])
  @@index([channelId, createdAt(sort: Desc)])
}

/** 라이브 가상 응원 (결제 없음 — 응원 포인트 CP) */
model LiveSupportEvent {
  id         String               @id @default(cuid())
  channelId  String
  senderId   String
  receiverId String
  type       LiveSupportEventType
  amount     Int
  message    String?
  metadata   Json?
  createdAt  DateTime             @default(now())

  sender   User         @relation("LiveSupportSender", fields: [senderId], references: [id])
  receiver User         @relation("LiveSupportReceiver", fields: [receiverId], references: [id])
  channel  VoiceChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId, createdAt(sort: Desc)])
  @@index([receiverId, createdAt(sort: Desc)])
}

model LiveSupportMission {
  id           String                   @id @default(cuid())
  channelId    String
  senderId     String
  receiverId   String
  title        String
  rewardAmount Int
  status       LiveSupportMissionStatus @default(PENDING)
  deadline     DateTime?
  createdAt    DateTime                 @default(now())
  resolvedAt   DateTime?

  sender   User         @relation("LiveMissionSender", fields: [senderId], references: [id])
  receiver User         @relation("LiveMissionReceiver", fields: [receiverId], references: [id])
  channel  VoiceChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId, status])
}

model LiveSupportPoll {
  id        String   @id @default(cuid())
  channelId String
  hostId    String
  question  String
  options   Json
  voteCost  Int      @default(100)
  status    String   @default("OPEN")
  endsAt    DateTime?
  createdAt DateTime @default(now())

  channel VoiceChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  host    User         @relation("LivePollHost", fields: [hostId], references: [id])
  votes   LiveSupportPollVote[]

  @@index([channelId, status])
}

model LiveSupportPollVote {
  id       String   @id @default(cuid())
  pollId   String
  userId   String
  optionId String
  amount   Int
  createdAt DateTime @default(now())

  poll LiveSupportPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  user User            @relation(fields: [userId], references: [id])

  @@unique([pollId, userId])
}

enum LiveVideoDonationStatus {
  AWAITING_URL
  PENDING_REVIEW
  QUEUED
  PLAYING
  PLAYED
  REJECTED
}

/** 유료 영상 후원 — YouTube URL + 구간 + 결제 */
model LiveVideoDonation {
  id           String                  @id @default(cuid())
  tipId        String                  @unique
  channelId    String
  senderId     String
  receiverId   String
  videoUrl     String?
  videoTitle   String?
  thumbnailUrl String?
  description  String?
  startSec     Int                     @default(0)
  endSec       Int?
  playToEnd    Boolean                 @default(false)
  durationSec  Int?
  anonymous    Boolean                 @default(false)
  status       LiveVideoDonationStatus @default(PENDING_REVIEW)
  rejectReason String?
  amount       Int
  createdAt    DateTime                @default(now())
  reviewedAt   DateTime?
  playedAt     DateTime?

  tip      Tip          @relation(fields: [tipId], references: [id], onDelete: Cascade)
  channel  VoiceChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  sender   User         @relation("LiveVideoDonationSender", fields: [senderId], references: [id])
  receiver User         @relation("LiveVideoDonationReceiver", fields: [receiverId], references: [id])

  @@index([channelId, status])
  @@index([senderId, createdAt(sort: Desc)])
}

model Subscription {
  id         String   @id @default(cuid())
  subscriberId String
  creatorId  String
  tier       String   @default("basic")
  amount     Int
  status     String   @default("active")
  subscribedSince DateTime @default(now())
  currentPeriodEnd DateTime
  stripeSubscriptionId String?
  createdAt  DateTime @default(now())
  subscriber User @relation("Subscriber", fields: [subscriberId], references: [id])
  creator    User @relation("Creator", fields: [creatorId], references: [id])
  @@unique([subscriberId, creatorId])
}

enum ProductType {
  ART
  EMOTICON
  BACKGROUND
  PROFILE_ITEM
}

model DigitalProduct {
  id          String   @id @default(cuid())
  sellerId    String
  title       String
  description String?  @db.Text
  price       Int
  type        ProductType
  previewUrl  String
  fileUrl     String
  salesCount  Int      @default(0)
  createdAt   DateTime @default(now())
  seller User @relation(fields: [sellerId], references: [id])
  orders OrderItem[]
}

model Order {
  id        String   @id @default(cuid())
  buyerId   String
  total     Int
  status    String   @default("pending")
  createdAt DateTime @default(now())
  buyer User @relation(fields: [buyerId], references: [id])
  items OrderItem[]
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String
  price     Int
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product DigitalProduct @relation(fields: [productId], references: [id])
}

enum PaymentIntentType {
  TIP
  PRODUCT
  PREMIUM
  EMOTICON
  LISTING_FEE
  PHYSICAL_GOODS
  EVENT_REGISTRATION
  CREATOR_EPISODE
  POST_MEDIA
  CREATOR_SUBSCRIPTION
  STUDIO_ASSET
}

enum EventPublishStatus {
  AWAITING_FEE
  PUBLISHED
}

enum EmoticonItemStatus {
  AVAILABLE
  USED
}

enum GoodsListingStatus {
  AWAITING_FEE
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum PhysicalOrderStatus {
  PENDING_PAYMENT
  PAID
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentIntentStatus {
  PENDING
  PAID
  FAILED
}

model PaymentIntent {
  id        String              @id @default(cuid())
  userId    String
  type      PaymentIntentType
  amount    Int
  status    PaymentIntentStatus @default(PENDING)
  metadata  Json
  paymentKey String?
  createdAt DateTime            @default(now())
  paidAt    DateTime?
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

// ============ 정산 · 지갑 (PG 입금 → 플랫폼 수수료 / 판매자 적립 → 출금) ============

enum LedgerEntryType {
  PAYMENT_GROSS
  PLATFORM_FEE
  SELLER_EARNING
  PAYOUT_REQUEST
  PAYOUT_REJECTED
}

enum PayoutStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

model Wallet {
  userId            String   @id
  availableBalance  Int      @default(0)
  totalEarned       Int      @default(0)
  totalWithdrawn    Int      @default(0)
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LedgerEntry {
  id              String          @id @default(cuid())
  userId          String?
  type            LedgerEntryType
  amount          Int
  balanceAfter    Int?
  referenceType   String?
  referenceId     String?
  paymentIntentId String?
  memo            String?
  createdAt       DateTime        @default(now())
  user            User?           @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([paymentIntentId])
  @@index([referenceType, referenceId])
}

model BankAccount {
  userId        String   @id
  bankName      String
  accountNumber String
  holderName    String
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PayoutRequest {
  id            String       @id @default(cuid())
  userId        String
  amount        Int
  status        PayoutStatus @default(PENDING)
  bankName      String
  accountNumber String
  holderName    String
  adminNote     String?
  processedById String?
  processedAt   DateTime?
  createdAt     DateTime     @default(now())
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  processedBy   User?        @relation("PayoutProcessor", fields: [processedById], references: [id])

  @@index([status, createdAt])
  @@index([userId])
}

model EmoticonPack {
  id         String   @id @default(cuid())
  slug       String   @unique
  name       String
  price      Int
  previewUrl String
  detailUrl  String?
  assetUrl   String
  sortOrder  Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  items      UserEmoticon[]
  gifts      EmoticonGift[]
}

model UserEmoticon {
  id        String             @id @default(cuid())
  userId    String
  packId    String
  status    EmoticonItemStatus @default(AVAILABLE)
  pricePaid Int
  usedAt    DateTime?
  createdAt DateTime           @default(now())
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  pack      EmoticonPack       @relation(fields: [packId], references: [id])
  gift      EmoticonGift?

  @@index([userId, status])
}

model EmoticonGift {
  id            String       @id @default(cuid())
  itemId        String       @unique
  senderId      String
  receiverId    String
  packId        String
  amount        Int
  platformFee   Int
  creatorAmount Int
  createdAt     DateTime     @default(now())
  item          UserEmoticon @relation(fields: [itemId], references: [id], onDelete: Cascade)
  sender        User         @relation("EmoticonGiftSender", fields: [senderId], references: [id])
  receiver      User         @relation("EmoticonGiftReceiver", fields: [receiverId], references: [id])
  pack          EmoticonPack @relation(fields: [packId], references: [id])

  @@index([receiverId, createdAt])
}

model GoodsListingRequest {
  id             String             @id @default(cuid())
  sellerId       String
  title          String
  description    String             @db.Text
  media          Json
  status         GoodsListingStatus @default(AWAITING_FEE)
  listingFeePaid Boolean            @default(false)
  rejectReason   String?
  createdAt      DateTime           @default(now())
  seller         User               @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  product        PhysicalProduct?

  @@index([sellerId, status])
}

model PhysicalProduct {
  id          String   @id @default(cuid())
  sellerId    String
  requestId   String?  @unique
  title       String
  description String   @db.Text
  price       Int
  images      Json
  shippingFee Int      @default(3000)
  stock       Int      @default(50)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  seller      User     @relation(fields: [sellerId], references: [id])
  request     GoodsListingRequest? @relation(fields: [requestId], references: [id])
  orderItems  PhysicalOrderItem[]
}

model PhysicalOrder {
  id            String              @id @default(cuid())
  buyerId       String
  sellerId      String
  total         Int
  productTotal  Int
  shippingFee   Int
  platformFee   Int
  sellerAmount  Int
  status        PhysicalOrderStatus @default(PENDING_PAYMENT)
  recipientName String
  phone         String
  zipCode       String
  address       String
  detailAddress String?
  trackingNo    String?
  createdAt     DateTime            @default(now())
  buyer         User                @relation("PhysicalOrderBuyer", fields: [buyerId], references: [id])
  seller        User                @relation("PhysicalOrderSeller", fields: [sellerId], references: [id])
  items         PhysicalOrderItem[]

  @@index([buyerId])
  @@index([sellerId, status])
}

model PhysicalOrderItem {
  id        String          @id @default(cuid())
  orderId   String
  productId String
  quantity  Int             @default(1)
  unitPrice Int
  order     PhysicalOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   PhysicalProduct @relation(fields: [productId], references: [id])
}

// ============ 중고거래 ============

enum UsedListingStatus {
  SELLING
  RESERVED
  SOLD
}

enum UsedSaleType {
  FIXED
  AUCTION
}

enum UsedAuctionState {
  LIVE
  ENDED
  CANCELLED
  PAYMENT_PENDING
  PAYMENT_COMPLETED
  PAYMENT_TIMEOUT
  TRANSFERRED_TO_NEXT_BIDDER
  PRICE_NEGOTIATION
  NEGOTIATION_COMPLETED
  NEGOTIATION_FAILED
}

enum UsedAuctionBidStatus {
  ACTIVE
  WINNER
  FORFEITED
  SUPERSEDED
}

enum UsedPriceOfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
  SUPERSEDED
}

enum UsedListingCategory {
  DIGITAL
  FIGURE
  GOODS
  COSPLAY
  BOOK
  FASHION
  OTHER
}

/** 청소년 보호 — 성인 인증 필요 품목 */
enum UsedRestrictedKind {
  NONE
  ALCOHOL
  TOBACCO
  ADULT
}

model UsedListing {
  id          String              @id @default(cuid())
  sellerId    String
  title       String
  description String              @db.Text
  /** 일반 판매가 또는 경매 시작가 */
  price       Int
  category    UsedListingCategory @default(OTHER)
  /** 애니/게임/IP 작품명 (예: 블루 아카이브, 원신) */
  workTitle   String?             @db.VarChar(120)
  /** 상품 종류 (피규어, 인형, 프라모델 등 — used-catalog) */
  productType String?             @db.VarChar(40)
  restrictedKind UsedRestrictedKind @default(NONE)
  status      UsedListingStatus   @default(SELLING)
  saleType    UsedSaleType        @default(FIXED)
  region      String
  meetPlace   String?             @db.VarChar(200)
  meetLat     Float?
  meetLng     Float?
  images      Json
  viewCount   Int                 @default(0)
  /** 경매 종료 시각 (saleType=AUCTION) */
  auctionEndsAt    DateTime?
  bidIncrement     Int?
  buyNowPrice      Int?
  /** 최저 낙찰가 — 미달 시 유찰 */
  reservePrice     Int?
  currentBidAmount Int?
  currentBidderId  String?
  auctionState     UsedAuctionState?
  bidCount         Int                 @default(0)
  /** 마감 직전 입찰 시 연장(분) */
  antiSnipeMinutes Int                 @default(5)
  /** 마감 연장 사용 횟수 (최대 5회) */
  auctionExtensionCount Int            @default(0)
  /** 낙찰 후 결제 마감 시각 */
  paymentDueAt              DateTime?
  paymentCompletedAt        DateTime?
  /** 현재 유효 낙찰자 (미결제 시 차순위로 변경) */
  winningBidderId           String?
  /** 차순위 협상 마감 시각 */
  negotiationDueAt          DateTime?
  negotiationBuyerId        String?
  agreedPrice               Int?
  forfeitedWinnerCount      Int                 @default(0)
  paymentReminder1hSent     Boolean             @default(false)
  paymentReminder10mSent    Boolean             @default(false)
  paymentTimeoutProcessed   Boolean             @default(false)
  negotiationTimeoutProcessed Boolean           @default(false)
  activeNegotiationRoomId   String?
  /** 향후 입찰 보증금 (현재 비활성) */
  depositEnabled            Boolean             @default(false)
  depositRate               Float?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  seller      User                @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  currentBidder User?             @relation("UsedAuctionWinner", fields: [currentBidderId], references: [id], onDelete: SetNull)
  winningBidder User?             @relation("UsedAuctionWinningBidder", fields: [winningBidderId], references: [id], onDelete: SetNull)
  negotiationBuyer User?          @relation("UsedAuctionNegotiationBuyer", fields: [negotiationBuyerId], references: [id], onDelete: SetNull)
  favorites   UsedFavorite[]
  tradeChats  UsedListingChat[]
  auctionBids UsedAuctionBid[]
  priceOffers UsedPriceOffer[]

  @@index([status, createdAt])
  @@index([sellerId])
  @@index([category])
  @@index([workTitle])
  @@index([productType])
  @@index([region])
  @@index([saleType, auctionEndsAt])
  @@index([auctionState])
  @@index([restrictedKind])
  @@index([paymentDueAt])
  @@index([negotiationDueAt])
  @@index([winningBidderId])
}

model UsedAuctionBid {
  id        String               @id @default(cuid())
  listingId String
  bidderId  String
  amount    Int
  bidStatus UsedAuctionBidStatus @default(ACTIVE)
  createdAt DateTime             @default(now())
  listing   UsedListing          @relation(fields: [listingId], references: [id], onDelete: Cascade)
  bidder    User                 @relation(fields: [bidderId], references: [id], onDelete: Cascade)

  @@index([listingId, createdAt(sort: Desc)])
  @@index([listingId, amount(sort: Desc)])
  @@index([bidderId, createdAt(sort: Desc)])
  @@index([listingId, bidderId])
}

/** 경매 차순위 가격 협상 제안 */
model UsedPriceOffer {
  id         String              @id @default(cuid())
  listingId  String
  roomId     String
  proposerId String
  amount     Int
  status     UsedPriceOfferStatus @default(PENDING)
  createdAt  DateTime            @default(now())
  listing    UsedListing         @relation(fields: [listingId], references: [id], onDelete: Cascade)
  proposer   User                @relation(fields: [proposerId], references: [id], onDelete: Cascade)

  @@index([listingId, createdAt(sort: Desc)])
  @@index([roomId, createdAt(sort: Desc)])
  @@index([listingId, status])
}

/** 중고 경매 전역 설정 (입찰 보증금 등) */
model UsedAuctionConfig {
  id                       String   @id @default("default")
  depositEnabled           Boolean  @default(false)
  depositRate              Float    @default(0.05)
  paymentDeadlineHours     Int      @default(5)
  negotiationDeadlineHours Int      @default(24)
  updatedAt                DateTime @updatedAt
}

model UsedFavorite {
  id        String      @id @default(cuid())
  userId    String
  listingId String
  createdAt DateTime    @default(now())
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   UsedListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
}

/** 중고거래 글별 1:1 채팅 (구매자–판매자) */
model UsedListingChat {
  id        String      @id @default(cuid())
  listingId String
  roomId    String      @unique
  buyerId   String
  createdAt DateTime    @default(now())
  listing   UsedListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyer     User        @relation("UsedListingChatBuyer", fields: [buyerId], references: [id], onDelete: Cascade)

  @@unique([listingId, buyerId])
  @@index([listingId])
}

// ============ COSPLAY BOARD (대여·구매) ============

enum CosplayBoardMode {
  RENTAL
  PURCHASE
}

enum CosplayBoardStatus {
  OPEN
  CLOSED
}

model CosplayBoardPost {
  id         String             @id @default(cuid())
  authorId   String
  mode       CosplayBoardMode
  title      String             @db.VarChar(200)
  content    String             @db.Text
  /** 원 단위 — 대여는 1일 기준, 구매는 판매가 */
  price      Int?
  priceLabel String?            @db.VarChar(80)
  region     String?            @db.VarChar(80)
  workTitle  String?            @db.VarChar(120)
  character  String?            @db.VarChar(80)
  sizeLabel  String?            @db.VarChar(40)
  images     Json               @default("[]")
  viewCount  Int                @default(0)
  isNotice   Boolean            @default(false)
  status     CosplayBoardStatus @default(OPEN)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  author   User                  @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments CosplayBoardComment[]

  @@index([mode, status, createdAt(sort: Desc)])
  @@index([authorId, createdAt(sort: Desc)])
  @@index([isNotice])
}

model CosplayBoardComment {
  id        String   @id @default(cuid())
  postId    String
  authorId  String
  content   String   @db.Text
  createdAt DateTime @default(now())

  post   CosplayBoardPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User             @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
}

model AdSlot {
  id           String   @id @default(cuid())
  position     String
  title        String
  imageUrl     String
  linkUrl      String
  sponsorName  String?
  ctaLabel     String?
  adCategory   String?
  isFeedAd     Boolean  @default(false)
  active       Boolean  @default(true)
  impressions  AdImpression[]
}

enum AnimeGenre {
  ACTION
  ROMANCE
  COMEDY
  FANTASY
  SCI_FI
  SLICE_OF_LIFE
  HORROR
  SPORTS
  MECHA
  ISEKAI
  SCHOOL
  MUSIC
  MYSTERY
  SUPERNATURAL
  DRAMA
  ADVENTURE
  OTHER
}

model Anime {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  titleEn     String?
  genre       AnimeGenre @default(OTHER)
  bannerUrl   String?
  coverUrl    String?
  synopsis    String?  @db.Text
  studio      String?
  characters  Json?
  voiceActors Json?
  worldInfo   String?  @db.Text
  infobox     String?  @db.Text
  airedFrom   DateTime?
  tags        String[]
  followerCount Int    @default(0)
  viewCount     Int    @default(0)
  isProtected   Boolean @default(false)
  creatorId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  creator     User     @relation("AnimeCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  revisions   AnimeRevision[]
  deleteRequests AnimeDeleteRequest[]

  @@index([viewCount])
  @@index([updatedAt(sort: Desc)])
  posts       Post[]
  followers   AnimeFollow[]
  cosplayers  CosplayerAnime[]
  goods       AnimeGoods[]
}

model AnimeRevision {
  id        String   @id @default(cuid())
  animeId   String
  editorId  String
  summary   String?
  snapshot  Json
  createdAt DateTime @default(now())

  anime  Anime @relation(fields: [animeId], references: [id], onDelete: Cascade)
  editor User  @relation("AnimeRevisionEditor", fields: [editorId], references: [id], onDelete: Cascade)

  @@index([animeId, createdAt(sort: Desc)])
}

model AnimeDeleteRequest {
  id          String   @id @default(cuid())
  animeId     String
  requesterId String
  reason      String   @db.Text
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())

  anime     Anime @relation(fields: [animeId], references: [id], onDelete: Cascade)
  requester User  @relation(fields: [requesterId], references: [id], onDelete: Cascade)

  @@index([status, createdAt(sort: Desc)])
}

model WikiSearchQuery {
  id        String   @id @default(cuid())
  query     String   @unique
  count     Int      @default(1)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model AnimeFollow {
  id       String   @id @default(cuid())
  userId   String
  animeId  String
  createdAt DateTime @default(now())
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  anime Anime @relation(fields: [animeId], references: [id], onDelete: Cascade)
  @@unique([userId, animeId])
}

model CosplayerAnime {
  id         String @id @default(cuid())
  profileId  String
  animeId    String
  character  String?
  profile CosplayerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  anime   Anime            @relation(fields: [animeId], references: [id], onDelete: Cascade)
  @@unique([profileId, animeId])
}

model AnimeGoods {
  id       String @id @default(cuid())
  animeId  String
  title    String
  type     String
  price    Int?
  imageUrl String?
  linkUrl  String?
  anime Anime @relation(fields: [animeId], references: [id], onDelete: Cascade)
}

model CreatorSupport {
  id          String   @id @default(cuid())
  supporterId String
  creatorId   String
  tier        SupportTierLevel @default(PEBBLE)
  totalAmount Int      @default(0)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
  supporter User @relation("Supporter", fields: [supporterId], references: [id], onDelete: Cascade)
  creator   User @relation("Creator", fields: [creatorId], references: [id], onDelete: Cascade)
  @@unique([supporterId, creatorId])
}

model AdImpression {
  id     String   @id @default(cuid())
  slotId String
  userId String?
  viewedAt DateTime @default(now())
  slot AdSlot @relation(fields: [slotId], references: [id])
  user User?  @relation(fields: [userId], references: [id])
}

// ============ EVENTS & OTAKU ============

model Event {
  id                  String             @id @default(cuid())
  title               String
  description         String             @db.Text
  type                String
  startsAt            DateTime
  endsAt              DateTime
  imageUrl            String?
  images              Json?
  prize               String?
  linkUrl             String?
  links               Json?
  videoUrl            String?
  createdById         String?
  communityId         String?
  status              EventPublishStatus @default(PUBLISHED)
  registrationFeePaid Boolean            @default(true)
  createdAt           DateTime           @default(now())
  createdBy           User?              @relation("EventCreator", fields: [createdById], references: [id], onDelete: SetNull)
  community           Community?           @relation(fields: [communityId], references: [id], onDelete: Cascade)
  participants        EventParticipant[]

  @@index([createdById, status])
  @@index([communityId, status])
  @@index([endsAt])
}

model EventParticipant {
  id       String @id @default(cuid())
  eventId  String
  userId   String
  entryUrl String?
  score    Int    @default(0)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([eventId, userId])
}

/** 서브컬처·애니 오프라인 행사 (지도 핀) — 수동/시드, 카카오 지오코딩 보조 */
model SubcultureEventPin {
  id          String    @id @default(cuid())
  title       String
  description String?   @db.Text
  category    String    @default("other")
  venueName   String?
  address     String?
  lat         Float?
  lng         Float?
  startsAt    DateTime
  endsAt      DateTime?
  sourceUrl   String?
  source      String    @default("seed")
  externalKey String?   @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([startsAt])
  @@index([endsAt])
}

model OtakuProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  favoriteChars String[]
  animeList     Json?
  gameList      Json?
  mangaList     Json?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RankingEntry {
  id        String   @id @default(cuid())
  category  String
  entityId  String
  entityType String
  score     Float
  rank      Int
  period    String
  updatedAt DateTime @updatedAt
}

// ============ MODERATION ============

enum ReportTargetType {
  USER
  POST
  COMMENT
  MESSAGE
  USED_LISTING
  LIVE_CHANNEL
  LIVE_CHAT
  STREAM_CLIP
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}

model Report {
  id         String   @id @default(cuid())
  reporterId String
  targetType ReportTargetType
  targetId   String
  reason     String
  details    String?  @db.Text
  status     ReportStatus @default(PENDING)
  createdAt  DateTime @default(now())
  reporter   User @relation("Reporter", fields: [reporterId], references: [id])
  reportedUserId String?
  reportedUser User? @relation("ReportedUser", fields: [reportedUserId], references: [id])
  postId     String?
  post       Post? @relation(fields: [postId], references: [id])
  commentId  String?
  comment    Comment? @relation(fields: [commentId], references: [id])
}

model ModLog {
  id        String   @id @default(cuid())
  actorId   String
  targetId  String
  action    String
  reason    String?
  metadata  Json?
  createdAt DateTime @default(now())
  actor  User @relation("ModActor", fields: [actorId], references: [id])
  target User @relation("ModTarget", fields: [targetId], references: [id])
}

model AccountSuspensionLog {
  id              String        @id @default(cuid())
  userId          String
  actorId         String?
  previousStatus  AccountStatus
  newStatus       AccountStatus
  reason          String?       @db.Text
  isPermanent     Boolean       @default(false)
  metadata        Json?
  createdAt       DateTime      @default(now())

  user  User  @relation("SuspensionTarget", fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("SuspensionActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model AccountAppeal {
  id                       String        @id @default(cuid())
  userId                   String
  accountStatusAtSubmit    AccountStatus
  suspensionReasonSnapshot String?       @db.Text
  title                    String
  content                  String        @db.Text
  contactEmail             String
  allowFollowUpEmail       Boolean       @default(true)
  status                   AppealStatus  @default(RECEIVED)
  adminNotes               String?       @db.Text
  adminId                  String?
  decisionNote             String?       @db.Text
  decidedAt                DateTime?
  infoRequestedAt          DateTime?
  infoDueAt                DateTime?
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  user        User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  admin       User?                     @relation("AppealAdmin", fields: [adminId], references: [id], onDelete: SetNull)
  attachments AccountAppealAttachment[]
  responses   AccountAppealResponse[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model AccountAppealAttachment {
  id        String   @id @default(cuid())
  appealId  String
  url       String
  filename  String
  mimeType  String
  sizeBytes Int
  createdAt DateTime @default(now())

  appeal AccountAppeal @relation(fields: [appealId], references: [id], onDelete: Cascade)

  @@index([appealId])
}

model AccountAppealResponse {
  id        String   @id @default(cuid())
  appealId  String
  authorId  String?
  content   String   @db.Text
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())

  appeal AccountAppeal @relation(fields: [appealId], references: [id], onDelete: Cascade)

  @@index([appealId, createdAt])
}

model BanEvasionSuspect {
  id           String   @id @default(cuid())
  userId       String
  linkedUserId String
  matchType    String
  metadata     Json?
  reviewed     Boolean  @default(false)
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime @default(now())

