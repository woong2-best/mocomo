// ============ DISCOVERY (친구·코스어 매칭 — opt-in) ============

enum DiscoveryGender {
  MALE
  FEMALE
  NONBINARY
  OTHER
  UNSPECIFIED
}

enum DiscoveryLookingFor {
  FRIENDS
  COSPLAY
  BOTH
}

enum DiscoverySwipeAction {
  PASS
  LIKE
  CHEER
}

enum DiscoveryMatchingMode {
  RECOMMENDED
  RANDOM
}

model DiscoveryProfile {
  id               String              @id @default(cuid())
  userId           String              @unique
  enabled          Boolean             @default(false)
  gender           DiscoveryGender     @default(UNSPECIFIED)
  showGender       Boolean             @default(true)
  city             String?
  lat              Float?
  lng              Float?
  maxDistanceKm    Int                 @default(50)
  minAge           Int                 @default(18)
  maxAge           Int                 @default(45)
  lookingFor       DiscoveryLookingFor @default(FRIENDS)
  matchingMode     DiscoveryMatchingMode @default(RECOMMENDED)
  preferredGenders DiscoveryGender[]
  pitch            String?             @db.Text
  showAge          Boolean             @default(false)
  lastActiveAt     DateTime            @default(now())
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([enabled, lastActiveAt])
  @@index([enabled, lookingFor])
}

model DiscoverySwipe {
  id         String               @id @default(cuid())
  fromUserId String
  toUserId   String
  action     DiscoverySwipeAction
  createdAt  DateTime             @default(now())

  fromUser User @relation("DiscoverySwipeFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User @relation("DiscoverySwipeTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([fromUserId, toUserId])
  @@index([fromUserId])
  @@index([toUserId, action])
}

model DiscoveryMatch {
  id        String   @id @default(cuid())
  userAId   String
  userBId   String
  matchedAt DateTime @default(now())
  unseenByA Boolean  @default(true)
  unseenByB Boolean  @default(true)

  userA User @relation("DiscoveryMatchA", fields: [userAId], references: [id], onDelete: Cascade)
  userB User @relation("DiscoveryMatchB", fields: [userBId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId])
  @@index([userAId, matchedAt(sort: Desc)])
  @@index([userBId, matchedAt(sort: Desc)])
}

model DiscoveryBlock {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("DiscoveryBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("DiscoveryBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
}

// ============ MoCoMo Studio (studio.mocomo.com — MoCoMo 본 서비스와 분리) ============

enum StudioAssetStatus {
  DRAFT
  SUBMITTED
  REVIEWING
  APPROVED
  REJECTED
  PUBLISHED
}

enum StudioAssetCategory {
  FURNITURE
  DECOR
  WALLPAPER
  FLOORING
  LIGHTING
  PLANT
  POSTER
  HOUSEHOLD
  AVATAR_ACCESSORY
  AVATAR_CLOTHING
}

model StudioCreatorProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  handle          String   @unique
  displayName     String
  bio             String?  @db.Text
  bannerUrl       String?
  featuredAssetId String?
  totalLikes      Int      @default(0)
  totalDownloads  Int      @default(0)
  totalSales      Int      @default(0)
  followerCount   Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([handle])
}

model StudioAsset {
  id              String              @id @default(cuid())
  creatorId       String
  name            String
  description     String?             @db.Text
  category        StudioAssetCategory
  status          StudioAssetStatus   @default(DRAFT)
  glbUrl          String?
  thumbnailUrl    String?
  tags            String[]            @default([])
  priceKrw        Int                 @default(0)
  isFree          Boolean             @default(true)
  polygonCount    Int?
  textureMaxSize  Int?
  fileSizeBytes   Int?
  validationLog   Json?
  rejectReason    String?             @db.Text
  likeCount       Int                 @default(0)
  downloadCount   Int                 @default(0)
  saleCount       Int                 @default(0)
  submittedAt     DateTime?
  reviewedAt      DateTime?
  publishedAt     DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  creator         User                @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  likes           StudioAssetLike[]
  purchases       StudioAssetPurchase[]
  catalogEntry    MocomoStudioCatalogItem?
  userInventory   StudioUserInventory[]

  @@index([creatorId, status])
  @@index([status, publishedAt])
  @@index([category, status])
}

model StudioCreatorFollow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("StudioFollower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("StudioFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
