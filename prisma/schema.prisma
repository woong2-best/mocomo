  @@index([status, createdAt(sort: Desc)])
  @@index([domain, createdAt(sort: Desc)])
  @@index([correlationId])
  @@index([ruleCode, createdAt(sort: Desc)])
}

/** Health Monitor — 시간대별 스냅샷 (Heatmap) */
