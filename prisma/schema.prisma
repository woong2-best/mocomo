  autoAction    String?
  autoActionOk  Boolean?
  resolvedAt    DateTime?
  resolvedById  String?
  createdAt     DateTime  @default(now())

  rule       AptEconomyHealthRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
