model StudioWalletTransaction {
  id            String   @id @default(cuid())
  userId        String
  type          String
  amount        Int
  balanceAfter  Int
  referenceType String?
  referenceId   String?
  memo          String?
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
}

model StudioPayoutRequest {
  id          String   @id @default(cuid())
  userId      String
  amountKrw   Int
  status      String   @default("PENDING")
  processedAt DateTime?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

/** MoCoMo 인벤토리 연동 — Published 자산 캐시 (APT 등에서 조회) */
model MocomoStudioCatalogItem {
  id            String   @id @default(cuid())
  studioAssetId String   @unique
  category      String
  name          String
  glbUrl        String
  thumbnailUrl  String?
  tags          String[] @default([])
  creatorId     String
  priceKrw      Int      @default(0)
  publishedAt   DateTime
  createdAt     DateTime @default(now())
  asset         StudioAsset @relation(fields: [studioAssetId], references: [id], onDelete: Cascade)

  @@index([category, publishedAt])
  @@index([creatorId])
}

model StudioBankAccount {
  userId        String @id
  bankName      String
  accountNumber String
  holderName    String
  updatedAt     DateTime @updatedAt
  user          User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/** 유저가 보유한 Studio 자산 (무료 획득·구매) — MoCoMo APT 연동용 */
model StudioUserInventory {
  id            String   @id @default(cuid())
  userId        String
  studioAssetId String
  source        String
  acquiredAt    DateTime @default(now())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset         StudioAsset @relation(fields: [studioAssetId], references: [id], onDelete: Cascade)

  @@unique([userId, studioAssetId])
  @@index([userId, acquiredAt])
}

/** MoCoMo 인앱 구매 → Studio 정산 이벤트 */
model StudioSettlementEvent {
  id            String   @id @default(cuid())
  userId        String
  studioAssetId String
  amountKrw     Int
  platformFee   Int
  creatorEarn   Int
  source        String   @default("MOCOMO_INAPP")
  externalRef   String?
  createdAt     DateTime @default(now())

  @@index([studioAssetId, createdAt])
  @@index([userId])
}
