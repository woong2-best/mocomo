enum DiscoveryGender {
  MALE
  FEMALE
  NONBINARY
  OTHER
  UNSPECIFIED
}

enum DiscoveryLookingFor {
  FRIENDS
  COSPLAY
  BOTH
}

enum DiscoverySwipeAction {
  PASS
  LIKE
  CHEER
}

enum DiscoveryMatchingMode {
  RECOMMENDED
  RANDOM
}

model DiscoveryProfile {
  id               String              @id @default(cuid())
  userId           String              @unique
  enabled          Boolean             @default(false)
  gender           DiscoveryGender     @default(UNSPECIFIED)
  showGender       Boolean             @default(true)
  city             String?
  lat              Float?
  lng              Float?
  maxDistanceKm    Int                 @default(50)
  minAge           Int                 @default(18)
  maxAge           Int                 @default(45)
  lookingFor       DiscoveryLookingFor @default(FRIENDS)
  matchingMode     DiscoveryMatchingMode @default(RECOMMENDED)
  preferredGenders DiscoveryGender[]
  pitch            String?             @db.Text
  showAge          Boolean             @default(false)
  lastActiveAt     DateTime            @default(now())
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([enabled, lastActiveAt])
  @@index([enabled, lookingFor])
}

model DiscoverySwipe {
  id         String               @id @default(cuid())
  fromUserId String
  toUserId   String
