  id               String   @id @default(cuid())
  name             String
  communityId      String?
  maxUsers         Int      @default(50)
  isLive           Boolean  @default(false)
  allowScreen      Boolean  @default(true)
  allowCamera      Boolean  @default(true)
  joinPasswordHash String?
  createdBy        String
  createdAt        DateTime @default(now())
  category         LiveStreamCategory @default(JUST_CHATTING)
  tags             String[] @default([])
  thumbnailUrl     String?
  description      String?  @db.VarChar(500)
  scheduledAt      DateTime?
  liveStatus       LiveStreamStatus @default(LIVE)
  slowModeSeconds  Int      @default(0)
  chatBannedWords  String[] @default([])
  donationGoalKrw  Int?
  /** 영상 후원 — 초당 과금(원), 최소금액, 최대 재생초 */
  videoDonationRateKrw Int @default(100)
  videoDonationMinKrw  Int @default(5000)
  videoDonationMaxSec  Int @default(120)
  vodUrl           String?
  egressId         String?
  broadcastMode    LiveBroadcastMode @default(BROWSER)
  liveVisibility   LiveVisibility    @default(PUBLIC)
  minViewerTier    SupportTierLevel?
  rtmpIngressId    String?
  rtmpUrl          String?
  rtmpStreamKey    String?
  /** WHIP 송출 중인 브라우저 탭 ID — 한 탭만 송출 */
  livePublisherTabId String? @db.VarChar(64)
  endedAt          DateTime?
  /** 방송 오버레이(텍스트·돌림판·추첨) — 시청자 동기화 */
  liveOverlayJson  Json?
  /** 분할 합방 — 좌: 호스트 / 우: CO_HOST */
  liveCollabSplitEnabled Boolean @default(false)
  liveCollabUserId       String?
  /** 방송 화면(OBS·플레이어) 후원 알림 — 기본 꺼짐, 알림센터는 항상 */
  donationAlertsOnStream Boolean @default(false)

  /** FIRST_PARTY = Cloudflare/LiveKit/SRS (숨김) · EXTERNAL = iframe */
  mediaSourceType  LiveMediaSourceType @default(FIRST_PARTY)
  externalProvider LiveExternalProvider?
  /** YouTube video id / Twitch login / Chzzk channel id */
  externalId       String? @db.VarChar(64)
  /** YouTube 등 — 채널 ID (후원 검증용, externalId와 분리) */
  externalChannelId String? @db.VarChar(128)
  externalWatchUrl String? @db.VarChar(500)
  /** 인증된 스트리밍 계정 — 후원 허용 조건 */
  connectedStreamingAccountId String?

  community      Community?       @relation(fields: [communityId], references: [id], onDelete: SetNull)
  connectedStreamingAccount ConnectedStreamingAccount? @relation(fields: [connectedStreamingAccountId], references: [id], onDelete: SetNull)
  linkedChatRoom ChatRoom?
  communityChannel CommunityChannel?
  members        VoiceMember[]
  chatMessages   LiveChatMessage[]
  clips          StreamClip[]
