  createdAt  DateTime             @default(now())

  fromUser User @relation("DiscoverySwipeFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User @relation("DiscoverySwipeTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([fromUserId, toUserId])
  @@index([fromUserId])
  @@index([toUserId, action])
}

model DiscoveryMatch {
  id        String   @id @default(cuid())
  userAId   String
  userBId   String
  matchedAt DateTime @default(now())
  unseenByA Boolean  @default(true)
  unseenByB Boolean  @default(true)

  userA User @relation("DiscoveryMatchA", fields: [userAId], references: [id], onDelete: Cascade)
  userB User @relation("DiscoveryMatchB", fields: [userBId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId])
  @@index([userAId, matchedAt(sort: Desc)])
  @@index([userBId, matchedAt(sort: Desc)])
}

model DiscoveryBlock {
  id        String   @id @default(cuid())
