  actorId    String
  action     String
  targetType String?
  targetId   String?
  ip         String?
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User @relation("SiteAdminAuditActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([targetId])
}

model PushSubscription {
