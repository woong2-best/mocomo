# ============================================================
# Supabase + Prisma 연결 (5432 직접 연결이 막힌 경우 필수)
# ============================================================
# 1) Supabase 대시보드 → 프로젝트 홈 → 우측 상단 [Connect] 버튼
#    또는: https://supabase.com/dashboard/project/wijmhtyuhhdupddtlcdh?showConnect=true
# 2) "ORMs" → Prisma 에서 URI 복사 (리전·비밀번호가 맞는 문자열)
# 3) Database Settings 에서 비밀번호 모르면 [Reset database password] 후 새 비밀번호 저장
#
# 아래 REGION 은 Connect 화면에 나오는 aws-0-XXXX 부분과 동일해야 합니다.
# 예: aws-0-ap-northeast-2.pooler.supabase.com → REGION=ap-northeast-2

SUPABASE_PROJECT_REF="wijmhtyuhhdupddtlcdh"
SUPABASE_DB_PASSWORD="여기에_데이터베이스_비밀번호"
SUPABASE_REGION="ap-southeast-2"

# Connect → ORMs → Prisma (aws-0 또는 aws-1 은 대시보드에 나온 그대로)
DATABASE_URL="postgresql://postgres.wijmhtyuhhdupddtlcdh:${SUPABASE_DB_PASSWORD}@aws-1-ap-southeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"

DIRECT_URL="postgresql://postgres.wijmhtyuhhdupddtlcdh:${SUPABASE_DB_PASSWORD}@aws-1-ap-southeast-2.pooler.supabase.com:5432/postgres?sslmode=require"

# ※ .env 에는 위 변수를 풀어서 한 줄 URL 로 넣어도 됩니다 (Prisma는 ${} 치환 안 함)

NEXT_PUBLIC_SUPABASE_URL="https://wijmhtyuhhdupddtlcdh.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# 32자 이상 랜덤 문자열 (PowerShell: [Convert]::ToBase64String((1..32|ForEach-Object{Get-Random -Max 256})))
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
NEXTAUTH_URL="http://localhost:3000"

# Toss Payments (후원·마켓·프리미엄)
# https://developers.tosspayments.com
TOSS_SECRET_KEY=""
NEXT_PUBLIC_TOSS_CLIENT_KEY=""

# LiveKit (라이브 방송 + DM 음성 통화)
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
NEXT_PUBLIC_LIVEKIT_URL=""

# Socket.IO (선택 — 없어도 통화는 DB 폴링으로 동작)
NEXT_PUBLIC_SOCKET_URL="http://localhost:3001"

# S3 / R2 (프로덕션 업로드) — 미설정 시 POST /api/upload/local
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET_NAME=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_PUBLIC_URL=""

# Resend (이메일)
RESEND_API_KEY=""
