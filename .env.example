# ============================================================
# Supabase + Prisma 연결 (5432 직접 연결이 막힌 경우 필수)
# ============================================================
# 1) Supabase 대시보드 → 프로젝트 홈 → 우측 상단 [Connect] 버튼
#    또는: https://supabase.com/dashboard/project/wijmhtyuhhdupddtlcdh?showConnect=true
# 2) "ORMs" → Prisma 에서 URI 복사 (리전·비밀번호가 맞는 문자열)
# 3) Database Settings 에서 비밀번호 모르면 [Reset database password] 후 새 비밀번호 저장
#
# 아래 REGION 은 Connect 화면에 나오는 aws-0-XXXX 부분과 동일해야 합니다.
# 예: aws-0-ap-northeast-2.pooler.supabase.com → REGION=ap-northeast-2

SUPABASE_PROJECT_REF="wijmhtyuhhdupddtlcdh"
SUPABASE_DB_PASSWORD="여기에_데이터베이스_비밀번호"
SUPABASE_REGION="ap-southeast-2"

# Connect → ORMs → Prisma (aws-0 또는 aws-1 은 대시보드에 나온 그대로)
DATABASE_URL="postgresql://postgres.wijmhtyuhhdupddtlcdh:${SUPABASE_DB_PASSWORD}@aws-1-ap-southeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"

DIRECT_URL="postgresql://postgres.wijmhtyuhhdupddtlcdh:${SUPABASE_DB_PASSWORD}@aws-1-ap-southeast-2.pooler.supabase.com:5432/postgres?sslmode=require"

# ※ .env 에는 위 변수를 풀어서 한 줄 URL 로 넣어도 됩니다 (Prisma는 ${} 치환 안 함)

NEXT_PUBLIC_SUPABASE_URL="https://wijmhtyuhhdupddtlcdh.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# Settings → API → service_role (서버 전용, 절대 클라이언트에 노출 금지)
SUPABASE_SERVICE_ROLE_KEY=""
# 기본값 mocomo-uploads — scripts/supabase-fix-all.sql 섹션 L 실행 후 사용
SUPABASE_STORAGE_BUCKET="mocomo-uploads"

# 32자 이상 랜덤 문자열 (PowerShell: [Convert]::ToBase64String((1..32|ForEach-Object{Get-Random -Max 256})))
AUTH_SECRET=""
# Optional separate secret for mobile access JWTs (defaults to AUTH_SECRET with domain prefix)
# MOBILE_JWT_SECRET=""
AUTH_URL="http://localhost:3000"

# 사이트 운영자 (대기업 방식: 환경 변수 + DB role, 요청마다 자동 승격 없음)
# 닉네임으로 @mocomocompany 계정을 먼저 회원가입한 뒤 한 번만: npm run operator:assign
SITE_OPERATOR_USERNAME="mocomocompany"
# SITE_OPERATOR_EMAIL="you@company.com"
# 배포 시 다른 ADMIN 자동 회수만 (승격 없음): OPERATOR_REVOKE_ON_DEPLOY="true"
AUTH_TRUST_HOST="true"
NEXTAUTH_URL="http://localhost:3000"

# Discord OAuth (무료) — https://discord.com/developers/applications → New Application → OAuth2
# Redirects 에 추가:
#   http://localhost:3000/api/auth/callback/discord
#   https://mocomo.net/api/auth/callback/discord
# Client ID → AUTH_DISCORD_ID, Client Secret → AUTH_DISCORD_SECRET (Vercel Production)
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""

# Google / Gmail OAuth — https://console.cloud.google.com/apis/credentials
# OAuth client → Authorized redirect URI:
#   http://localhost:3000/api/auth/callback/google
#   https://mocomo.net/api/auth/callback/google
# AUTH_GOOGLE_ID=""  (또는 GOOGLE_CLIENT_ID)
# AUTH_GOOGLE_SECRET=""  (또는 GOOGLE_CLIENT_SECRET)
#
# Google OAuth 개인정보 암호화 (프로덕션 필수) — 32바이트 키
# PowerShell: [Convert]::ToBase64String((1..32|ForEach-Object{Get-Random -Max 256}))
# OAUTH_ENCRYPTION_KEY=""
# (권장) HMAC 조회용 별도 키 — 미설정 시 OAUTH_ENCRYPTION_KEY 사용
# OAUTH_HMAC_KEY=""
# 키 로테이션 — 새 키로 암호화, 이전 키는 복호화 전용
# OAUTH_ENCRYPTION_KEY_ID="v2"
# OAUTH_ENCRYPTION_KEY_PREVIOUS_ID="v1"
# OAUTH_ENCRYPTION_KEY_PREVIOUS=""

# X (Twitter) OAuth 2.0 — https://developer.x.com/en/portal/dashboard
# User authentication settings → OAuth 2.0 → Redirect URI:
#   http://localhost:3000/api/auth/callback/twitter
#   https://mocomo.net/api/auth/callback/twitter
# AUTH_TWITTER_ID=""
# AUTH_TWITTER_SECRET=""

# LINE Login — https://developers.line.biz/console/
# LINE Login 채널 → Callback URL:
#   http://localhost:3000/api/auth/callback/line
#   https://mocomo.net/api/auth/callback/line
# AUTH_LINE_ID="" / AUTH_LINE_SECRET="" 또는 LINE_CLIENT_ID / LINE_CLIENT_SECRET
# LINE_CLIENT_ID=""
# LINE_CLIENT_SECRET=""

# Naver Login — https://developers.naver.com/apps/
# Callback URL:
#   http://localhost:3000/api/auth/callback/naver
#   https://mocomo.net/api/auth/callback/naver
# AUTH_NAVER_ID=""  (또는 NAVER_CLIENT_ID / NAVER_ID)
# AUTH_NAVER_SECRET=""  (또는 NAVER_CLIENT_SECRET / NAVER_SECRET)

# Stripe Checkout (후원·마켓·프리미엄) — https://stripe.com/kr
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Stripe Webhook (후원 자동 완료) — checkout.session.completed
# URL https://your-domain.com/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 자체 송출(Cloudflare/LiveKit Ingress/SRS) — false 로 숨김 (코드 삭제 아님)
# 프로덕션 Vercel에도 false 로 설정할 것
NEXT_PUBLIC_LIVE_ENABLED="false"
# 외부 플랫폼 임베드 라이브 룸 (유튜브/트위치/치지직)
NEXT_PUBLIC_EXTERNAL_LIVE_ENABLED="true"
# 치지직 iframe 강제: true=임베드 / false=새 창만 (미설정 시 프로브)
# NEXT_PUBLIC_CHZZK_EMBED_ENABLED=""
# OBS 오버레이 서명 (없으면 AUTH_SECRET 사용)
# LIVE_OVERLAY_SECRET=""
# YouTube Data API — Made for Kids 체크 · 수동 채널 조회 (임베드 전)
# YOUTUBE_DATA_API_KEY=""
# YouTube 스트리밍 OAuth (youtube.readonly 민감 범위 — Google 앱 검증 후에만 true)
# YOUTUBE_STREAMING_OAUTH_ENABLED="false"
# YOUTUBE_STREAMING_CLIENT_ID=""
# YOUTUBE_STREAMING_CLIENT_SECRET=""
# Twitch 스트리밍 계정 OAuth (필수 — Twitch 연결용)
# TWITCH_CLIENT_ID=""
# TWITCH_CLIENT_SECRET=""
# OAuth state 서명 (미설정 시 AUTH_SECRET 사용)
# STREAMING_OAUTH_STATE_SECRET=""
# 최소 출금 금액 (원)
MIN_PAYOUT_KRW="10000"

# Cloudflare Stream — 자체 송출 중단 시 Live Input 불필요.
# 피드 VOD HLS용으로만 남을 수 있음 (docs/LIVE_INFRA_COST_INVENTORY.md).
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_STREAM_API_TOKEN=""
NEXT_PUBLIC_CLOUDFLARE_STREAM_CUSTOMER_HOST="customer-xxxxx.cloudflarestream.com"
# LIVE_INGEST_ENGINE="cloudflare"

# LiveKit — 통화·DM 유지 (방송 Ingress 아님 — 프로젝트 해지 금지)
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
NEXT_PUBLIC_LIVEKIT_URL=""

# Web Push — 앱 밖·오프라인 수신 통화 (npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_SUBJECT="mailto:support@mocomo.net"

# FCM — Android/iOS 푸시 (권장: Firebase Admin HTTP v1)
# Firebase Console → 프로젝트 설정 → 서비스 계정 → 새 비공개 키 → JSON 전체를 한 줄로
FIREBASE_SERVICE_ACCOUNT=""
# (구) Legacy 서버 키 — v1 설정 전까지 fallback
FIREBASE_SERVER_KEY=""
FCM_SERVER_KEY=""

# SRS — 예비 (Vultr) scripts/SRS_STREAMING_SETUP.md
SRS_RTMP_URL="rtmp://127.0.0.1:1935/live"
NEXT_PUBLIC_SRS_HLS_BASE_URL="http://127.0.0.1:8080/live"
# SRS_WEBHOOK_SECRET=""

# Socket.IO (선택 — 없으면 채팅은 API 폴링으로 실시간 동기화)
NEXT_PUBLIC_SOCKET_URL="http://localhost:3001"
# 서버 액션 → Socket 방송 (socket 서버 + NEXT_PUBLIC_SOCKET_URL 프로덕션 URL 일치)
SOCKET_RELAY_URL=""
SOCKET_RELAY_SECRET=""

# S3 / R2 (프로덕션 업로드) — 미설정 시 POST /api/upload/local
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET_NAME=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_PUBLIC_URL=""

# Resend (이메일) — resend.com 에서 API 키 발급
# 프로덕션: resend.com/domains 에서 mocomo.net DNS 인증 후 발송 가능
RESEND_API_KEY=""
# 발신 주소 — Resend SPF/DKIM이 붙는 send 서브도메인과 일치해야 Outlook/iCloud 수신 가능
# EMAIL_FROM="MoCoMo <noreply@send.mocomo.net>"
# EMAIL_REPLY_TO="support@mocomo.net"
# Resend 무료 한도 안내용 (선택): 가입 이메일
# RESEND_ACCOUNT_EMAIL="you@example.com"

# Cloudflare Turnstile (이메일 가입 봇 차단) — https://dash.cloudflare.com → Turnstile
# 위젯 Hostname 에 mocomo.net · localhost · *.vercel.app 추가 필수 (없으면 「확인 중」만 돔)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# (선택) Upstash Redis — IP 기반 추가 제한
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# (선택) 운영 점검 API — /api/health 상세, bootstrap 수동 실행
# CRON_SECRET="긴랜덤문자열"

# Apick 1원 계좌 인증 (국내 계좌·중고·판매자) — https://apick.app
APICK_API_KEY=""
# 계좌번호 HMAC 지문 (미설정 시 AUTH_SECRET 사용, 프로덕션 별도 키 권장)
# BANK_FINGERPRINT_SECRET=""
# 개발 시 Apick 없이 콘솔 로그 (실제 1원 송금 없음)
# APICK_DEV_LOG="true"

# 국세청 사업자등록 진위확인·상태조회 (판매자 사업자 등록) — https://www.data.go.kr
# 공공데이터포털 → 국세청_사업자등록정보 진위확인 및 상태조회 서비스 → 일반 인증키
NTS_BUSINESSMAN_SERVICE_KEY=""
# 개발 시 API 없이 검증 스킵 (로컬 UI 테스트용)
# NTS_DEV_SKIP="true"

# (구) Solapi/Twilio SMS — Apick 1원 인증으로 대체됨
# SOLAPI_API_KEY=""
# SOLAPI_API_SECRET=""
# SOLAPI_SENDER_PHONE="01012345678"

# 중고거래 AI 상품 설명 (무료) — https://aistudio.google.com/apikey
# GEMINI_API_KEY=""

# 카카오 로컬 API — 중고거래 거래 장소 검색·지도 좌표 (KR, 필수)
# https://developers.kakao.com → 앱 → REST API 키, Local API 활성화
KAKAO_REST_API_KEY=""
# 카카오맵 JavaScript 키 — 웹 직거래 지도 (KR). REST 키와 별개
NEXT_PUBLIC_KAKAO_JS_KEY=""
# 모바일 카카오맵 Native App Key (Expo extra / EXPO_PUBLIC_*)
# EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY=""

# (선택) Google AdSense — 데스크톱 좌·우 레일에 자동 광고 슬롯 (미설정 시 DB/기본 배너)
# NEXT_PUBLIC_ADSENSE_CLIENT="ca-pub-xxxxxxxx"
# NEXT_PUBLIC_ADSENSE_RAIL_LEFT_SLOT=""
# NEXT_PUBLIC_ADSENSE_RAIL_RIGHT_SLOT=""

# ============================================================
# MoCoMo Studio (studio.mocomo.com) — docs/MOCOMO_STUDIO_DEPLOY.md
# ============================================================
NEXT_PUBLIC_STUDIO_URL="https://studio.mocomo.com"
NEXT_PUBLIC_STUDIO_HOST="studio.mocomo.com"
# MoCoMo APT·정산 API 공유 시크릿 (32자 이상 권장)
STUDIO_INTEGRATION_SECRET=""
# (선택) Studio 전용 Supabase 버킷 — 미설정 시 SUPABASE_STORAGE_BUCKET + studio/ prefix
# STUDIO_STORAGE_BUCKET="mocomo-studio"

# ============================================================
# Forensic watermark (WEB paid video only) — docs/WATERMARK_FORENSICS.md
# ============================================================
# Production default: disabled until explicitly enabled
WATERMARK_ENABLED="false"
WATERMARK_VERSION="1"
# 32+ byte secret (base64 or hex). Server-only — never expose to client.
# PowerShell: [Convert]::ToBase64String((1..32|ForEach-Object{Get-Random -Max 256}))
# WATERMARK_MASTER_SECRET=""
