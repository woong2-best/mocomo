# dependencies
/node_modules
**/node_modules/
/.pnp
.pnp.js
.yarn/install-state.gz

# Gradle (local daemon/cache — RN/Android builds; not source)
.gradle-agent/
.gradle-local/
**/.gradle/

# Expo / RN
**/.expo/
apps/mobile/dist/
**/web-build/
apps/mobile/modules/**/android/build/
.metro-health-check*
**/.kotlin/
*-firebase-adminsdk-*.json
*.jks
*.keystore
!android/app/debug.keystore

# testing
/coverage
test-results/
playwright-report/
.playwright/

# next.js
/.next/
/out/

# monorepo / tooling caches
.turbo/
.cache/
.parcel-cache/
.eslintcache
.swc/

# production
/build
**/dist/

# misc
.DS_Store
*.pem
.tmp/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files
.env
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma
/prisma/*.db
/prisma/*.db-journal

# android release artifacts (uploaded to Play Console, not versioned)
/*.aab
/*.apk
/gradle-bundle*.log
/build-log.txt

# IDE
.idea/

# diagnostic captures and asset working copies — these ship to production as
# static assets if tracked, and nothing in the app references them
/public/apt/_diag/
/public/diorama/stickers/**/_rc1-backup/
/public/diorama/stickers/**/_rc1-out/
*.webp.tmp

# local scratch (diagnostic screenshots, captured logs)
/_t-*.png
/_table-crop-test.png
/tmp-*
/vercel-deploy*.log
/vercel-fail-logs.txt

# local uploads (dev fallback)
/public/uploads/
/data/private/

# large demo recordings (keep edit-mode-demo.webm only)
/public/diorama/page@*.webm

# iOS / Xcode local (Capacitor + RN generated trees)
**/Pods/
**/DerivedData/
**/xcuserdata/

# Python / local venv scratch (scripts, games tooling)
__pycache__/
*.py[cod]
.venv/
venv/

# local DB migration artifacts (PII) and portable postgres binaries
/.migration-dump/
/.tools/
