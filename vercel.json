{
  "buildCommand": "npm run vercel-build",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/cron/used-auctions",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/cron/subculture-events",
      "schedule": "30 16 * * *"
    },
    {
      "path": "/api/cron/abandoned-live",
      "schedule": "0 17 * * *"
    },
    {
      "path": "/api/cron/iap-retry",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/iap-voided",
      "schedule": "0 * * * *"
    }
  ],
  "functions": {
    "src/app/api/live/[channelId]/flv/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/cron/used-auctions/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/cron/subculture-events/route.ts": {
      "maxDuration": 120
    },
    "src/app/api/cron/abandoned-live/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/cron/iap-retry/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/cron/iap-voided/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/studio/upload/route.ts": {
      "maxDuration": 60
    }
  }
}
