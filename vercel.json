{
  "buildCommand": "npm run vercel-build",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/cron/used-auctions",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/cron/subculture-events",
      "schedule": "30 16 * * *"
    },
    {
      "path": "/api/cron/abandoned-live",
      "schedule": "0 17 * * *"
    },
    {
      "path": "/api/cron/iap-retry",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/iap-voided",
      "schedule": "30 14 * * *"
    },
    {
      "path": "/api/cron/purge-deleted-accounts",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/cron/risk-decay",
      "schedule": "0 19 * * *"
    },
    {
      "path": "/api/cron/market-auto-confirm",
      "schedule": "0 20 * * *"
    }
  ],
  "functions": {
    "src/app/api/live/[channelId]/flv/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/cron/used-auctions/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/cron/subculture-events/route.ts": {
      "maxDuration": 120
    },
    "src/app/api/cron/abandoned-live/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/cron/iap-retry/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/cron/iap-voided/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/cron/purge-deleted-accounts/route.ts": {
      "maxDuration": 120
    },
    "src/app/api/cron/risk-decay/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/cron/market-auto-confirm/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/studio/upload/route.ts": {
      "maxDuration": 60
    }
  }
}
